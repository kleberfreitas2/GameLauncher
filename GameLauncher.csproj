<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GameLauncher</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>GLauncher</AssemblyTitle>
    <Product>GLauncher</Product>
    <Version>2.5.0</Version>
    <Authors>Kleber Freitas</Authors>
    <Company>Kleber Freitas</Company>
    <Copyright>Copyright (c) 2024-2026 Kleber Freitas</Copyright>
    <Description>GLauncher - Game Launcher estilo PS5</Description>
    <FileDescription>GLauncher - Game Launcher</FileDescription>
    <AssemblyVersion>2.5.0.0</AssemblyVersion>
    <FileVersion>2.5.0.0</FileVersion>
  </PropertyGroup>

  <!-- Release publish settings: self-contained, single file, optimized -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="craftersmine.SteamGridDB.Net" Version="1.1.7" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="MaterialDesignThemes" Version="5.1.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.67.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.2" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.74.0" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\xbox_a_button.png" />
    <Resource Include="Assets\epic_logo.png" />
    <Resource Include="Assets\Backgrounds\360_F_861510294_6Je3kKMSC7wNfW0JIZf0OyYQcGCzB8y9.jpg" />
    <Resource Include="Assets\Backgrounds\86462-593059278_tiny.jpg" />
    <Resource Include="Assets\Backgrounds\pc-gaming-broken-controller-zvbj1ryoiptz09af.jpg" />
    <Resource Include="Assets\Backgrounds\pngtree-neon-glowing-video-game-controllers-on-a-black-background-image_16521725.jpg" />
    <Resource Include="Assets\Backgrounds\pngtree-vibrant-dual-tone-video-game-controller-a-unique-blend-of-blue-image_16314927.jpg" />
  </ItemGroup>
</Project>
