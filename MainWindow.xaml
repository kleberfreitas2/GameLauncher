<Window x:Class="GameLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:ctrl="clr-namespace:GameLauncher.Controls" xmlns:converters="clr-namespace:GameLauncher.Converters" Title="GLauncher" Icon="Assets/icon.ico" Height="700" Width="1200" MinHeight="500" MinWidth="800" WindowStartupLocation="CenterScreen" TextElement.Foreground="{DynamicResource MaterialDesignBody}" TextElement.FontFamily="{DynamicResource MaterialDesignFont}" Background="{DynamicResource AppBackgroundBrush}">
  <Window.Resources>
    <Style x:Key="HeaderActionButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="20,10"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.35"/></Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.87"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Logo -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/icon.png" Width="44" Height="44" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="20" FontWeight="Bold">
              <Run Text="G" Foreground="{DynamicResource AccentGreenBrush}"/><Run Text="Launcher" Foreground="White"/>
            </TextBlock>
            <TextBlock Text="Seus jogos favoritos em um so lugar" FontSize="11" Foreground="#9999BB"/>
          </StackPanel>
        </StackPanel>

        <!-- Search bar -->
        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12,8" Margin="30,0" VerticalAlignment="Center" MaxWidth="600">
          <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="3" Opacity="0.5"/></Border.Effect>
          <DockPanel>
            <md:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="#0088FF" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,10,0">
              <md:PackIcon.Effect><DropShadowEffect Color="#00AAFF" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/></md:PackIcon.Effect>
            </md:PackIcon>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent" BorderThickness="0" Foreground="#0077EE" FontSize="14" FontWeight="Medium"
                     VerticalAlignment="Center" CaretBrush="#0088FF"
                     md:HintAssist.Hint="Buscar jogo..."
                     md:HintAssist.Foreground="#AABBDD"
                     md:TextFieldAssist.DecorationVisibility="Hidden"/>
          </DockPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Fundo" Command="{Binding ChangeBackgroundCommand}" Style="{StaticResource HeaderActionButton}" Margin="0,0,10,0"/>
          <Button Content="Tema" Command="{Binding OpenThemeCommand}" Style="{StaticResource HeaderActionButton}" Margin="0,0,10,0"/>
          <Button Content="+ ADICIONAR JOGO" Command="{Binding AddGameCommand}" Style="{StaticResource HeaderActionButton}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Image Source="{Binding BackgroundImage}" Stretch="UniformToFill" Opacity="0.55" Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVisibility}}" Panel.ZIndex="0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
      <Rectangle Fill="#0D0D0D" Opacity="0.15" Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVisibility}}" Panel.ZIndex="1" IsHitTestVisible="False"/>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Games.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <md:PackIcon Kind="GamepadVariantOutline" Width="100" Height="100" Foreground="#2A2A2A" HorizontalAlignment="Center"/>
        <TextBlock Text="Nenhum jogo adicionado ainda" FontSize="20" Foreground="#555555" HorizontalAlignment="Center" Margin="0,20,0,0"/>
        <TextBlock Text="Clique em + ADICIONAR JOGO para comecar" FontSize="13" Foreground="#444444" HorizontalAlignment="Center" Margin="0,8,0,0"/>
      </StackPanel>
      <ScrollViewer Padding="30,20" VerticalScrollBarVisibility="Auto"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Games.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
        <ItemsControl ItemsSource="{Binding GamesView}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Border x:Name="SelectionBorder" Width="189" Height="314" Margin="8" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="0">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <DataTrigger Value="True">
                      <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqualityConverter}">
                          <Binding />
                          <Binding Path="DataContext.SelectedGame" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                        </MultiBinding>
                      </DataTrigger.Binding>
                      <Setter Property="BorderBrush" Value="#00E676"/>
                      <Setter Property="Effect">
                        <Setter.Value>
                          <DropShadowEffect Color="#00E676" BlurRadius="18" ShadowDepth="0" Opacity="0.7"/>
                        </Setter.Value>
                      </Setter>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
            <Border x:Name="CardRoot" Width="185" Height="310" CornerRadius="10" Cursor="Hand" ClipToBounds="True" Background="{DynamicResource CardBackgroundBrush}">
              <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ShowDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/></Border.InputBindings>
              <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="#2A2A4A"/></Setter.Value></Setter><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#7C4DFF" BlurRadius="22" Opacity="0.55"/></Setter.Value></Setter><Setter Property="Tag" Value="1"/></Trigger><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FFD700" BlurRadius="22" ShadowDepth="0" Opacity="0.7"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Border.Style>
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="95"/></Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="0" ClipToBounds="True" Background="{DynamicResource CardImageBackgroundBrush}"><Grid><md:PackIcon Kind="GamepadVariant" Width="75" Height="75" Foreground="#7C4DFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoImage, Converter={StaticResource BoolToVisibility}}"/><Image Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}" Source="{Binding EffectiveImagePath, Converter={StaticResource PathToImageConverter}, ConverterParameter=185}" Stretch="UniformToFill"/></Grid></Border>
                <Border Grid.Row="0" VerticalAlignment="Top" Panel.ZIndex="1" Background="#BB111130"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,4,4"><Button Width="28" Height="28" Padding="0" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Background="#22223A" BorderThickness="0" ToolTip="Favorito" Margin="0,0,3,0"><md:PackIcon Kind="{Binding FavoriteIcon}" Width="14" Height="14" Foreground="{Binding FavoriteColor}"/></Button><Button Width="28" Height="28" Padding="0" Command="{Binding DataContext.ChangeImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Background="#333355" BorderThickness="0" ToolTip="Alterar imagem" Margin="0,0,3,0"><md:PackIcon Kind="Camera" Width="14" Height="14" Foreground="#AAAAFF"/></Button><Button Width="28" Height="28" Padding="0" Command="{Binding DataContext.SearchCoverCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Background="#223344" BorderThickness="0" ToolTip="Buscar capa online" Margin="0,0,3,0"><md:PackIcon Kind="Magnify" Width="14" Height="14" Foreground="#66AAFF"/></Button><Button Width="28" Height="28" Padding="0" Command="{Binding DataContext.FetchIgdbInfoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Background="#0A1A2E" BorderThickness="0" ToolTip="Buscar info IGDB" Margin="0,0,3,0"><md:PackIcon Kind="InformationOutline" Width="14" Height="14" Foreground="#88DDFF"/></Button><Button Width="28" Height="28" Padding="0" Command="{Binding DataContext.RenameGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Background="#223322" BorderThickness="0" ToolTip="Renomear" Margin="0,0,3,0"><md:PackIcon Kind="Pencil" Width="14" Height="14" Foreground="#88FF88"/></Button><Button Width="28" Height="28" Padding="0" Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Background="#AA2222" BorderThickness="0" ToolTip="Remover jogo"><md:PackIcon Kind="Close" Width="14" Height="14" Foreground="White"/></Button></StackPanel></Border>
                <StackPanel Grid.Row="1" Margin="14,10" VerticalAlignment="Top"><TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><md:PackIcon Kind="ClockOutline" Width="11" Height="11" Foreground="#9999BB" VerticalAlignment="Center" Margin="0,0,3,0"/><TextBlock Text="{Binding LastPlayedText}" FontSize="10" Foreground="#9999BB" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Jogar" FontSize="11" Foreground="#00E676" Margin="0,5,0,0" FontWeight="SemiBold"/></StackPanel>
              </Grid>
            </Border>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl></ScrollViewer>

      <!-- ══ Detail Panel Overlay ══════════════════════════════════════ -->
      <Border Panel.ZIndex="10" CornerRadius="0" ClipToBounds="True">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding ShowDetailPanel}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <!-- Semi-transparent backdrop -->
          <Border Background="#CC0A0A18" MouseLeftButtonDown="DetailBackdrop_Click"/>

          <!-- Detail card -->
          <Border Background="#1A1A2E" CornerRadius="16" MaxWidth="820" MaxHeight="480"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Padding="0" Margin="40">
            <Border.Effect>
              <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="8" Opacity="0.7"/>
            </Border.Effect>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Cover image -->
              <Border Grid.Column="0" CornerRadius="16,0,0,16" ClipToBounds="True"
                      Background="{DynamicResource CardImageBackgroundBrush}">
                <Grid>
                  <md:PackIcon Kind="GamepadVariant" Width="80" Height="80"
                               Foreground="#333355" HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding DetailGame.HasNoImage, Converter={StaticResource BoolToVisibility}}"/>
                  <Image Source="{Binding DetailGame.EffectiveImagePath, Converter={StaticResource PathToImageConverter}, ConverterParameter=240}"
                         Stretch="UniformToFill"
                         Visibility="{Binding DetailGame.HasImage, Converter={StaticResource BoolToVisibility}}"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
              </Border>

              <!-- Info panel -->
              <Grid Grid.Column="1" Margin="28,24,28,20">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Close button -->
                <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="30" Height="30" Padding="0" Margin="0,-4,-8,0"
                        Command="{Binding CloseDetailCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                  <md:PackIcon Kind="Close" Width="18" Height="18" Foreground="#666688"/>
                </Button>

                <!-- Title -->
                <TextBlock Grid.Row="0" Text="{Binding DetailGame.DisplayName}"
                           FontSize="22" FontWeight="Bold" Foreground="White"
                           TextWrapping="Wrap" Margin="0,0,36,0"/>

                <!-- Meta info -->
                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                  <!-- Rating -->
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <md:PackIcon Kind="Star" Width="15" Height="15" Foreground="#FFD700"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Rating: " FontSize="12" Foreground="#9999BB" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DetailGame.RatingDisplay}" FontSize="12"
                               Foreground="#FFD700" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                  <!-- Year -->
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <md:PackIcon Kind="Calendar" Width="15" Height="15" Foreground="#66AAFF"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Lançamento: " FontSize="12" Foreground="#9999BB" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DetailGame.YearDisplay}" FontSize="12"
                               Foreground="#66AAFF" VerticalAlignment="Center"/>
                  </StackPanel>
                  <!-- Genres -->
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <md:PackIcon Kind="TagOutline" Width="15" Height="15" Foreground="#AA88FF"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Gêneros: " FontSize="12" Foreground="#9999BB" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DetailGame.GenresDisplay}" FontSize="12"
                               Foreground="#AA88FF" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  </StackPanel>
                  <!-- Last played -->
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <md:PackIcon Kind="ClockOutline" Width="15" Height="15" Foreground="#9999BB"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding DetailGame.LastPlayedText}" FontSize="12"
                               Foreground="#9999BB" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>

                <!-- Description -->
                <ScrollViewer Grid.Row="2" Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <TextBlock Text="{Binding DetailGame.SummaryDisplay}"
                             FontSize="12" Foreground="#AAAACC"
                             TextWrapping="Wrap" LineHeight="19"/>
                </ScrollViewer>

                <!-- Play button with Xbox A -->
                <Button Grid.Row="3" Margin="0,16,0,0"
                        HorizontalAlignment="Stretch" Height="48"
                        Command="{Binding LaunchDetailGameCommand}"
                        Cursor="Hand" BorderThickness="0">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="PlayBorder" Background="#00C853" CornerRadius="10"
                              Padding="20,0">
                        <Border.Effect>
                          <DropShadowEffect Color="#00E676" BlurRadius="16"
                                            ShadowDepth="0" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                          <!-- Xbox A Button -->
                          <Grid Width="30" Height="30" Margin="0,0,10,0">
                            <Ellipse Fill="#107C10" Stroke="#00E676" StrokeThickness="2"/>
                            <TextBlock Text="A" FontSize="15" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                          </Grid>
                          <TextBlock Text="JOGAR" FontSize="16" FontWeight="Bold"
                                     Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="PlayBorder" Property="Background" Value="#00E676"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter TargetName="PlayBorder" Property="Background" Value="#00B248"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}" Padding="20,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Status text -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock Text="{Binding StatusMessage}" Foreground="#888888" FontSize="12"/>
          <TextBlock Text="Desenvolvido por Kleber Freitas" Foreground="#666688" FontSize="10" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Gamepad status (centro) -->
        <TextBlock Grid.Column="1" Text="{Binding GamepadStatus}" Foreground="#00E676" FontSize="11"
                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Hardware Gauges -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
          <!-- CPU Usage -->
          <ctrl:ArcGauge Value="{Binding CpuUsage}" Label="CPU" SubLabel="{Binding CpuTempText}" Margin="4,0"/>
          <!-- GPU Usage -->
          <ctrl:ArcGauge Value="{Binding GpuUsage}" Label="GPU" SubLabel="{Binding GpuTempText}" Margin="4,0"/>
          <!-- CPU Temp -->
          <ctrl:ArcGauge Value="{Binding CpuTemp}" Label="CPU °C" IsTemperature="True" Margin="4,0"/>
          <!-- GPU Temp -->
          <ctrl:ArcGauge Value="{Binding GpuTemp}" Label="GPU °C" IsTemperature="True" Margin="4,0"/>
          <!-- RAM -->
          <ctrl:ArcGauge Value="{Binding RamUsage}" Label="RAM" Margin="4,0"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
