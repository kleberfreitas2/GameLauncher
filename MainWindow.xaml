<Window x:Class="GameLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:ctrl="clr-namespace:GameLauncher.Controls" xmlns:converters="clr-namespace:GameLauncher.Converters" Title="GLauncher" Icon="Assets/icon.ico" Height="700" Width="1200" MinHeight="500" MinWidth="800" WindowStartupLocation="CenterScreen" TextElement.Foreground="{DynamicResource MaterialDesignBody}" TextElement.FontFamily="{DynamicResource MaterialDesignFont}" Background="{DynamicResource AppBackgroundBrush}">
  <Window.Resources>
    <Style x:Key="HeaderActionButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="20,10"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.35"/></Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.87"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Logo -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/icon.png" Width="44" Height="44" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="20" FontWeight="Bold">
              <Run Text="G" Foreground="{DynamicResource AccentGreenBrush}"/><Run Text="Launcher" Foreground="White"/>
            </TextBlock>
            <TextBlock Text="Seus jogos favoritos em um so lugar" FontSize="11" Foreground="#9999BB"/>
          </StackPanel>
        </StackPanel>

        <!-- Search bar -->
        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12,8" Margin="30,0" VerticalAlignment="Center" MaxWidth="600">
          <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="3" Opacity="0.5"/></Border.Effect>
          <DockPanel>
            <md:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="#0088FF" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,10,0">
              <md:PackIcon.Effect><DropShadowEffect Color="#00AAFF" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/></md:PackIcon.Effect>
            </md:PackIcon>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent" BorderThickness="0" Foreground="#0077EE" FontSize="14" FontWeight="Medium"
                     VerticalAlignment="Center" CaretBrush="#0088FF"
                     md:HintAssist.Hint="Buscar jogo..."
                     md:HintAssist.Foreground="#AABBDD"
                     md:TextFieldAssist.DecorationVisibility="Hidden"/>
          </DockPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Tema" Command="{Binding OpenThemeCommand}" Style="{StaticResource HeaderActionButton}" Margin="0,0,10,0"/>
          <Button Content="+ ADICIONAR JOGO" Command="{Binding AddGameCommand}" Style="{StaticResource HeaderActionButton}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Left Sidebar ══════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="#0D1117" BorderThickness="0,0,1,0" BorderBrush="#1A2533">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="BIBLIOTECA" FontSize="11" FontWeight="SemiBold"
                       Foreground="#556677" Margin="16,12,16,8"/>

            <!-- Empty state -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Games.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <md:PackIcon Kind="GamepadVariantOutline" Width="48" Height="48" Foreground="#2A3544" HorizontalAlignment="Center"/>
              <TextBlock Text="Nenhum jogo" FontSize="12" Foreground="#445566" HorizontalAlignment="Center" Margin="0,8,0,0"/>
              <TextBlock Text="Adicione jogos acima" FontSize="10" Foreground="#334455" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Game list -->
            <ListBox Grid.Row="1" ItemsSource="{Binding GamesView}"
                     SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
              <ListBox.Style>
                <Style TargetType="ListBox">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Games.Count}" Value="0">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ListBox.Style>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Margin" Value="0"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                Padding="12,8" Cursor="Hand"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#151D27"/>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#151D27"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#00AAFF"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <Border Width="36" Height="36" CornerRadius="6" ClipToBounds="True"
                            DockPanel.Dock="Left" Margin="0,0,10,0" Background="#1A2533">
                      <Grid>
                        <md:PackIcon Kind="GamepadVariant" Width="20" Height="20"
                                     Foreground="#334455" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding HasNoImage, Converter={StaticResource BoolToVisibility}}"/>
                        <Image Source="{Binding EffectiveImagePath, Converter={StaticResource PathToImageConverter}, ConverterParameter=36}"
                               Stretch="UniformToFill"
                               Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}"/>
                      </Grid>
                    </Border>
                    <md:PackIcon Kind="Star" Width="12" Height="12" Foreground="#FFD700"
                                 DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0"
                                 Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="#88CCDD"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <!-- ══ Right: Detail View ════════════════════════════════════ -->
        <Grid Grid.Column="1">
          <!-- Empty state when no game selected -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ShowDetailPanel}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <md:PackIcon Kind="GamepadVariantOutline" Width="80" Height="80" Foreground="#2A2A3A" HorizontalAlignment="Center"/>
            <TextBlock Text="Selecione um jogo" FontSize="18" Foreground="#555566" HorizontalAlignment="Center" Margin="0,16,0,0"/>
          </StackPanel>

          <!-- Detail content -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
              <Style TargetType="ScrollViewer">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ShowDetailPanel}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ScrollViewer.Style>

            <StackPanel>
              <!-- Banner Image Area -->
              <Border Height="380" ClipToBounds="True" Background="#0A0A15">
                <Grid>
                  <Image Source="{Binding DetailGame.EffectiveImagePath, Converter={StaticResource PathToImageConverter}, ConverterParameter=1920}"
                         Stretch="UniformToFill" Opacity="0.85"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         Visibility="{Binding DetailGame.HasImage, Converter={StaticResource BoolToVisibility}}"/>
                  <md:PackIcon Kind="GamepadVariant" Width="120" Height="120" Foreground="#1A1A2E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding DetailGame.HasNoImage, Converter={StaticResource BoolToVisibility}}"/>
                  <!-- Gradient overlay -->
                  <Border VerticalAlignment="Bottom" Height="200">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#EE0D0D0D" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <!-- Title overlay -->
                  <TextBlock Text="{Binding DetailGame.DisplayName}"
                             FontSize="32" FontWeight="Bold" Foreground="White"
                             VerticalAlignment="Bottom" Margin="30,0,30,20"
                             TextWrapping="Wrap">
                    <TextBlock.Effect>
                      <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.8"/>
                    </TextBlock.Effect>
                  </TextBlock>
                </Grid>
              </Border>

              <!-- Action row: Buttons + Cover thumbnail -->
              <Border Background="#111118" Padding="30,16">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <!-- Jogar button -->
                  <Button Grid.Column="0" Command="{Binding LaunchDetailGameCommand}"
                          Cursor="Hand" BorderThickness="0" Height="42" MinWidth="130">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="JogarBd" Background="#1A5276" CornerRadius="6" Padding="24,0">
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <md:PackIcon Kind="Play" Width="18" Height="18" Foreground="White" Margin="0,0,8,0"/>
                            <TextBlock Text="Jogar" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                          </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="JogarBd" Property="Background" Value="#217DBB"/>
                          </Trigger>
                          <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="JogarBd" Property="Background" Value="#154360"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>

                  <!-- Mais button -->
                  <Button Grid.Column="1" Margin="12,0,0,0" Height="42" MinWidth="100"
                          Cursor="Hand" BorderThickness="0"
                          x:Name="BtnMais" Click="BtnMais_Click">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="MaisBd" Background="#2A3A4A" CornerRadius="6" Padding="24,0">
                          <TextBlock Text="Mais" FontSize="15" FontWeight="SemiBold" Foreground="#88BBCC"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MaisBd" Property="Background" Value="#3A4A5A"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                    <Button.ContextMenu>
                      <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="⭐ Alternar Favorito"
                                  Command="{Binding ToggleFavoriteCommand}"
                                  CommandParameter="{Binding DetailGame}"/>
                        <MenuItem Header="🖼 Alterar Imagem"
                                  Command="{Binding ChangeImageCommand}"
                                  CommandParameter="{Binding DetailGame}"/>
                        <MenuItem Header="🔍 Buscar Capa Online"
                                  Command="{Binding SearchCoverCommand}"
                                  CommandParameter="{Binding DetailGame}"/>
                        <MenuItem Header="ℹ Buscar Info IGDB"
                                  Command="{Binding FetchIgdbInfoCommand}"
                                  CommandParameter="{Binding DetailGame}"/>
                        <MenuItem Header="✏ Renomear"
                                  Command="{Binding RenameGameCommand}"
                                  CommandParameter="{Binding DetailGame}"/>
                        <Separator/>
                        <MenuItem Header="🗑 Remover Jogo"
                                  Command="{Binding RemoveGameCommand}"
                                  CommandParameter="{Binding DetailGame}"/>
                      </ContextMenu>
                    </Button.ContextMenu>
                  </Button>

                  <!-- Cover thumbnail -->
                  <Border Grid.Column="3" Width="70" Height="90" CornerRadius="6" ClipToBounds="True"
                          Background="#1A1A2E">
                    <Grid>
                      <md:PackIcon Kind="GamepadVariant" Width="30" Height="30" Foreground="#333355"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding DetailGame.HasNoImage, Converter={StaticResource BoolToVisibility}}"/>
                      <Image Source="{Binding DetailGame.EffectiveImagePath, Converter={StaticResource PathToImageConverter}, ConverterParameter=70}"
                             Stretch="UniformToFill"
                             Visibility="{Binding DetailGame.HasImage, Converter={StaticResource BoolToVisibility}}"
                             RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                  </Border>
                </Grid>
              </Border>

              <!-- Details + Description two-column area -->
              <Border Background="#0F0F18" Padding="30,20,30,30">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <!-- Detalhes -->
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Detalhes" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                    <Border Background="#161622" CornerRadius="8" Padding="16,12">
                      <StackPanel>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Atividade Recente" FontSize="12" Foreground="#778899"/>
                          <TextBlock Grid.Column="1" Text="{Binding DetailGame.LastPlayedText}" FontSize="12" Foreground="#AABBCC"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Local de instalação" FontSize="12" Foreground="#778899"/>
                          <TextBlock Grid.Column="1" Text="{Binding DetailGame.InstallDirectory}" FontSize="12"
                                     Foreground="#5599CC" TextTrimming="CharacterEllipsis"
                                     ToolTip="{Binding DetailGame.InstallDirectory}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Plataforma" FontSize="12" Foreground="#778899"/>
                          <TextBlock Grid.Column="1" Text="PC (Windows)" FontSize="12" Foreground="#5599CC"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Gênero" FontSize="12" Foreground="#778899"/>
                          <TextBlock Grid.Column="1" Text="{Binding DetailGame.GenresDisplay}" FontSize="12"
                                     Foreground="#5599CC" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Rating IGDB" FontSize="12" Foreground="#778899"/>
                          <TextBlock Grid.Column="1" Text="{Binding DetailGame.RatingDisplay}" FontSize="12" Foreground="#FFD700"/>
                        </Grid>
                        <Grid Margin="0,0,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Data de lançamento" FontSize="12" Foreground="#778899"/>
                          <TextBlock Grid.Column="1" Text="{Binding DetailGame.YearDisplay}" FontSize="12" Foreground="#5599CC"/>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <!-- Descrição -->
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Descrição" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                    <Border Background="#161622" CornerRadius="8" Padding="16,12">
                      <TextBlock Text="{Binding DetailGame.SummaryDisplay}" FontSize="12"
                                 Foreground="#AABBCC" TextWrapping="Wrap" LineHeight="20"/>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}" Padding="20,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Status text -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock Text="{Binding StatusMessage}" Foreground="#888888" FontSize="12"/>
          <TextBlock Text="Desenvolvido por Kleber Freitas" Foreground="#666688" FontSize="10" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Gamepad status (centro) -->
        <TextBlock Grid.Column="1" Text="{Binding GamepadStatus}" Foreground="#00E676" FontSize="11"
                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Hardware Gauges -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
          <!-- CPU Usage -->
          <ctrl:ArcGauge Value="{Binding CpuUsage}" Label="CPU" SubLabel="{Binding CpuTempText}" Margin="4,0"/>
          <!-- GPU Usage -->
          <ctrl:ArcGauge Value="{Binding GpuUsage}" Label="GPU" SubLabel="{Binding GpuTempText}" Margin="4,0"/>
          <!-- CPU Temp -->
          <ctrl:ArcGauge Value="{Binding CpuTemp}" Label="CPU °C" IsTemperature="True" Margin="4,0"/>
          <!-- GPU Temp -->
          <ctrl:ArcGauge Value="{Binding GpuTemp}" Label="GPU °C" IsTemperature="True" Margin="4,0"/>
          <!-- RAM -->
          <ctrl:ArcGauge Value="{Binding RamUsage}" Label="RAM" Margin="4,0"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
