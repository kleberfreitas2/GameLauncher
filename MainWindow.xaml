                                    <DataTrigger Binding="{Binding FocusedHeaderItem}" Value="Help">
                                        <Setter Property="BorderBrush" Value="#00E676"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#00E676" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Command="{Binding OpenHelpCommand}"
                            VerticalAlignment="Center"
                            Cursor="Hand" BorderThickness="0" Background="Transparent" Padding="0"
                            ToolTip="Manual de utilização">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="HelpBd" Background="Transparent" CornerRadius="14" Padding="4">
                                        <md:PackIcon Kind="HelpCircle" Width="24" Height="24" Foreground="#2196F3"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HelpBd" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                    <Border VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="{Binding GamepadStatus}">
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <md:PackIcon Kind="MicrosoftXboxController" Width="20" Height="20" Foreground="#556677" VerticalAlignment="Center">
                                    <md:PackIcon.Style>
                                        <Style TargetType="md:PackIcon">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GamepadConnected}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </md:PackIcon.Style>
                                </md:PackIcon>
                                <md:PackIcon Kind="MicrosoftXboxController" Width="20" Height="20" Foreground="#00E676"
                               VerticalAlignment="Center">
                                    <md:PackIcon.Style>
                                        <Style TargetType="md:PackIcon">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GamepadConnected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </md:PackIcon.Style>
                                    <md:PackIcon.Effect>
                                        <DropShadowEffect Color="#00E676" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                    </md:PackIcon.Effect>
                                </md:PackIcon>
                            </Grid>
                            <Border Margin="6,0,0,0" CornerRadius="8" Background="#22FFFFFF" Padding="6,2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasGamepadBattery, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <md:PackIcon Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,3,0">
                                        <md:PackIcon.Style>
                                            <Style TargetType="md:PackIcon">
                                                <Setter Property="Kind" Value="Battery"/>
                                                <Setter Property="Foreground" Value="#00E676"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GamepadBatteryIcon}" Value="Battery10">
                                                        <Setter Property="Kind" Value="Battery10"/>
                                                        <Setter Property="Foreground" Value="#FF5252"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GamepadBatteryIcon}" Value="Battery40">
                                                        <Setter Property="Kind" Value="Battery40"/>
                                                        <Setter Property="Foreground" Value="#FFD740"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GamepadBatteryIcon}" Value="Battery70">
                                                        <Setter Property="Kind" Value="Battery70"/>
                                                        <Setter Property="Foreground" Value="#69F0AE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GamepadBatteryIcon}" Value="Battery">
                                                        <Setter Property="Kind" Value="Battery"/>
                                                        <Setter Property="Foreground" Value="#00E676"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </md:PackIcon.Style>
                                    </md:PackIcon>
                                    <TextBlock Text="{Binding GamepadBatteryText}" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#00E676"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GamepadBatteryIcon}" Value="Battery10">
                                                        <Setter Property="Foreground" Value="#FF5252"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GamepadBatteryIcon}" Value="Battery40">
                                                        <Setter Property="Foreground" Value="#FFD740"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,16,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GamepadFocusBorder}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FocusedHeaderItem}" Value="Settings">
                                        <Setter Property="BorderBrush" Value="#00E676"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#00E676" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">



                            <Button ToolTip="GLauncher AI — Assistente Gamer"
                            Command="{Binding OpenAiAssistantCommand}"
                            x:Name="BtnAi" Click="BtnAi_Click"
                            Style="{StaticResource HeaderIconButtonStyle}">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="AiBd" Background="Transparent" CornerRadius="14" Padding="4">
                                            <md:PackIcon Kind="Robot" Width="20" Height="20" Foreground="#FF3B3B"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="AiBd" Property="Background" Value="#22FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Botão de Troféus -->
                            <Button ToolTip="Meus Troféus"
                                    Command="{Binding OpenTrophiesCommand}"
                                    Style="{StaticResource HeaderIconButtonStyle}">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="TrophyBd" Background="Transparent" CornerRadius="14" Padding="4">
                                            <md:PackIcon Kind="Trophy" Width="20" Height="20"
                                                         Foreground="#FFD700"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TrophyBd" Property="Background" Value="#22FFD700"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>


                            <Button x:Name="BtnGear" Click="BtnGear_Click"
                  ToolTip="Configurações"
                  Style="{StaticResource HeaderIconButtonStyle}">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="GearBd" Background="Transparent" CornerRadius="14" Padding="4">
                                            <md:PackIcon Kind="CogOutline" Width="20" Height="20" Foreground="#8899AA"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="GearBd" Property="Background" Value="#22FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Mode=Self}}">
                                        <MenuItem Header="Adicionar Jogo" Command="{Binding AddGameCommand}">
                                            <MenuItem.Icon>
                                                <md:PackIcon Kind="Plus" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Tema" Command="{Binding OpenThemeCommand}">
                                            <MenuItem.Icon>
                                                <md:PackIcon Kind="ThemeLightDark" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sons (Ligar/Desligar)" Command="{Binding ToggleSoundCommand}"
                                          IsCheckable="True" IsChecked="{Binding IsSoundEnabled, Mode=OneWay}">
                                            <MenuItem.Icon>
                                                <md:PackIcon Kind="VolumeHigh" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="FPS Overlay no Jogo (Ligar/Desligar)" Command="{Binding ToggleFpsOverlayCommand}"
                                          IsCheckable="True" IsChecked="{Binding IsFpsOverlayEnabled, Mode=OneWay}">
                                            <MenuItem.Icon>
                                                <md:PackIcon Kind="Speedometer" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Alternar Favorito"
                          Command="{Binding ToggleFavoriteCommand}"
                          CommandParameter="{Binding DetailGame}"/>
                                        <MenuItem Header="Alterar Imagem"
                          Command="{Binding ChangeImageCommand}"
                          CommandParameter="{Binding DetailGame}"/>
                                        <MenuItem Header="Alterar Logotipo"
                          Command="{Binding ChangeLogoCommand}"
                          CommandParameter="{Binding DetailGame}"/>
                                        <MenuItem Header="Buscar Capa Online"
                          Command="{Binding SearchCoverCommand}"
                          CommandParameter="{Binding DetailGame}"/>
                                        <MenuItem Header="Buscar Fundo (Screenshot/Key Art)"
                          Command="{Binding SearchBackgroundCommand}"
                          CommandParameter="{Binding DetailGame}"/>
                                        <MenuItem Header="Buscar Info IGDB"
                          Command="{Binding FetchIgdbInfoCommand}"
                          CommandParameter="{Binding DetailGame}"/>
                                        <MenuItem Header="Re-escanear Tecnologias"
                          Command="{Binding RescanGameTechCommand}">
                                            <MenuItem.Icon>
                                                <md:PackIcon Kind="Gpu" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Recomendação Gráfica (Hardware)"
                          Command="{Binding OpenHwRecommendationCommand}">
                                            <MenuItem.Icon>
                                                <md:PackIcon Kind="Chip" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Renomear"
                          Command="{Binding RenameGameCommand}"
                          CommandParameter="{Binding DetailGame}"/>
                                        <Separator/>
                                        <MenuItem Header="Remover Jogo"
                          Command="{Binding RemoveGameCommand}"
                          CommandParameter="{Binding DetailGame}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>


                    <Button x:Name="BtnBigPicture" Command="{Binding ToggleBigPictureModeCommand}"
                            ToolTip="Modo Big Picture — BETA (em teste para TVs)" Margin="0,0,12,0"
                            Style="{StaticResource HeaderIconButtonStyle}">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Grid>
                                    <Border x:Name="BpBd" Background="Transparent" CornerRadius="14" Padding="4">
                                        <md:PackIcon x:Name="BpIcon" Kind="{Binding BigPictureIcon}" Width="20" Height="20" Foreground="#8899AA"/>
                                    </Border>

                                    <Border Background="#E65100" CornerRadius="4"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Padding="2,0" Margin="0,-2,-2,0">
                                        <TextBlock Text="BETA" FontSize="6" FontWeight="Bold"
                                                   Foreground="White" FontFamily="Segoe UI"/>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BpBd" Property="Background" Value="#22FFFFFF"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsBigPictureMode}" Value="True">
                                        <Setter TargetName="BpIcon" Property="Foreground" Value="#00E676"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="{Binding CurrentTime}" FontSize="16" FontWeight="SemiBold"
                     Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                              Cursor="Hand" ToolTip="Clique para alterar avatar"
                              MouseLeftButtonUp="Avatar_Click">

                        <!-- Avatar -->

                        <!-- Gamerscore dos Troféus (estilo Xbox) -->
                        <!-- Avatar -->
                        <Border Width="34" Height="34" CornerRadius="19" ClipToBounds="True"
                                Background="#22334455" BorderThickness="2" BorderBrush="#33FFFFFF">
                            <Grid>
                                <md:PackIcon Kind="AccountCircle" Width="50" Height="34" Foreground="#556677"
                                             Visibility="{Binding HasNoAvatar, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Left" Margin="-10,0,0,0"/>
                                <Image Source="{Binding AvatarPath, ConverterParameter=38, Converter={StaticResource PathToImageConverter}}"
                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>

                        <!-- Gamerscore dos Troféus (estilo Xbox) -->
                        <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="{Binding TrophyGamerscoreDisplay}"
                                       FontSize="12" FontWeight="Bold" Foreground="#FFD700"
                                       FontFamily="Segoe UI" LineHeight="14"/>
                            <TextBlock Text="{Binding TrophyCountDisplay}"
                                       FontSize="9" Foreground="#8899AA"
                                       FontFamily="Segoe UI" LineHeight="12"/>
                        </StackPanel>

                    </StackPanel>


                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnWinMinimize" Click="BtnWinMinimize_Click" Width="36" Height="28"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False" ToolTip="Minimizar">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <TextBlock Text="&#x2014;" Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnWinMaxRestore" Click="BtnWinMaxRestore_Click" Width="36" Height="28"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False" ToolTip="Restaurar/Maximizar">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <Canvas Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Rectangle Width="8" Height="8" Stroke="#AAAAAA" StrokeThickness="1.2" Canvas.Left="3" Canvas.Top="0" Fill="Transparent"/>
                                            <Rectangle Width="8" Height="8" Stroke="#AAAAAA" StrokeThickness="1.2" Canvas.Left="0" Canvas.Top="3" Fill="Transparent"/>
                                        </Canvas>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnWinClose" Click="BtnWinClose_Click" Width="36" Height="28"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False" ToolTip="Fechar">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <TextBlock Text="&#x2716;" Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                                            <Setter TargetName="bd" Property="TextElement.Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Margin="0,55,0,0" Grid.RowSpan="3">
            <ctrl:AnimatedImage x:Name="BackgroundAnim"
                          ImagePath="{Binding DetailGame.EffectiveBackgroundPath}"
                          Stretch="UniformToFill" Opacity="0.90"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   UseLayoutRounding="True"
                   VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                   Visibility="{Binding DetailGame.HasBackground, Converter={StaticResource BoolToVisibility}}"
                   IsHitTestVisible="False"/>
            <Border IsHitTestVisible="False"
              Visibility="{Binding DetailGame.HasBackground, Converter={StaticResource BoolToVisibility}}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#10000000" Offset="0"/>
                        <GradientStop Color="#66080810" Offset="0.55"/>
                        <GradientStop Color="#DD0D0D15" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border x:Name="FpsBadge"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,20,0" Panel.ZIndex="100"
                    Background="#CC0A0A18" CornerRadius="12"
                    Padding="16,8" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Speedometer" Width="22" Height="22"
                                 Foreground="#8888AA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="FpsText" Text="--" FontSize="28" FontWeight="Bold"
                               Foreground="#00E676" VerticalAlignment="Center"/>
                    <TextBlock Text=" FPS" FontSize="14" FontWeight="Bold"
                               Foreground="#8888AA" VerticalAlignment="Center" Margin="4,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Panel.ZIndex="99"
              Visibility="{Binding IsLoading, ElementName=BackgroundAnim, Converter={StaticResource BoolToVisibility}}"
              Background="#01000000" IsHitTestVisible="True">
                <Border Background="#CC0A0A18" CornerRadius="14"
                  VerticalAlignment="Top" HorizontalAlignment="Center"
                  Margin="0,100,0,0" Padding="30,18">
                    <StackPanel HorizontalAlignment="Center" Width="280">
                        <TextBlock Text="Carregando animação..." FontSize="14" Foreground="#CCDDEE"
                         HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <ProgressBar Value="{Binding LoadingProgress, ElementName=BackgroundAnim, Mode=OneWay}"
                           Minimum="0" Maximum="100" Height="8"
                           Foreground="{DynamicResource AccentBrush}"
                           Background="#33FFFFFF"/>
                        <TextBlock Foreground="#99AABB" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock.Text>
                                <Binding Path="LoadingProgress" ElementName="BackgroundAnim" StringFormat="{}{0:0}%" Mode="OneWay"/>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Border>

            <Grid Panel.ZIndex="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Games.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border>
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.4" RadiusX="0.8" RadiusY="0.9">
                            <GradientStop Color="#1A1040" Offset="0"/>
                            <GradientStop Color="#0F0C24" Offset="0.5"/>
                            <GradientStop Color="#0A0A14" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <Border Opacity="0.12" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.3,0.3" RadiusX="0.4" RadiusY="0.5">
                            <GradientStop x:Name="AccentGradientStop" Color="#107C10" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <Border Opacity="0.08" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.75,0.7" RadiusX="0.35" RadiusY="0.45">
                            <GradientStop Color="#00E676" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <Image Source="Assets/icon.png" Width="72" Height="72" Margin="0,0,0,8"
                           RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"
                           x:Name="WelcomeIcon">
                        <Image.Effect>
                            <DropShadowEffect x:Name="WelcomeIconGlow" Color="#107C10" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
                        </Image.Effect>
                    </Image>

                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Run Text="Bem-vindo ao " FontSize="28" FontWeight="Light" Foreground="#BBBBCC"/>
                        <Run Text="G" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentGreenBrush}"/>
                        <Run Text="Launcher" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.7"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <TextBlock Text="Sua biblioteca de jogos pessoal rápida, elegante e pronta para jogar."
                               FontSize="14" Foreground="#7788AA" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,28"/>

                    <Border Background="#18182A" CornerRadius="16" Padding="32,28" Margin="0,0,0,24"
                            BorderThickness="1" BorderBrush="#222244">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.4"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🚀  Comece em 3 passos:" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#CCCCDD" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="1"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Clique no ícone ⚙️ (engrenagem) no canto superior direito"
                                           FontSize="13" Foreground="#99AABB" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="2"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Selecione 'Adicionar Jogo' e escolha o executável (.exe)"
                                           FontSize="13" Foreground="#99AABB" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="3"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Pronto! Aproveite a experiência com capa, fundo e info automáticas"
                                           FontSize="13" Foreground="#99AABB" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="💡 Dica: Conecte um controle Xbox ou PlayStation para navegar como um console!"
                               FontSize="11" Foreground="#556677" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Panel.ZIndex="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Games.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <Border Grid.Row="0"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="18,14,0,0"
                        Background="#CC000000"
                        BorderBrush="#E65100" BorderThickness="1"
                        CornerRadius="5" Padding="8,3"
                        Panel.ZIndex="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBigPictureMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#E65100" CornerRadius="3" Padding="4,1" Margin="0,0,7,0">
                            <TextBlock Text="BETA" FontSize="9" FontWeight="Bold"
                                       Foreground="White" FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock Text="Modo Big Picture — em teste para TVs"
                                   FontSize="10" Foreground="#AABBCC"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="0" VerticalAlignment="Bottom" Margin="50,0,50,12">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowDetailPanel}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <Image Source="{Binding DetailGame.LogoPath, Converter={StaticResource PathToImageConverter}}"
                   MaxHeight="100" MaxWidth="420"
                   Stretch="Uniform" HorizontalAlignment="Left"
                   Margin="0,0,0,10"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding DetailGame.HasLogo, Converter={StaticResource BoolToVisibility}}">
                            <Image.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.85"/>
                            </Image.Effect>
                        </Image>
                        <TextBlock Text="{Binding DetailGame.DisplayName}"
                       FontSize="38" FontWeight="Bold" Foreground="White"
                       Margin="0,0,0,10" TextWrapping="Wrap"
                       Visibility="{Binding DetailGame.HasNoLogo, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Grid>


                <Grid Grid.Row="0" VerticalAlignment="Bottom" Margin="50,0,50,16">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBigPictureMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <Border Grid.Column="0" HorizontalAlignment="Left" MaxWidth="720" Padding="28,18" CornerRadius="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowDetailPanel}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Background>
                            <SolidColorBrush Color="#000000" Opacity="0.7"/>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Image Source="{Binding DetailGame.LogoPath}" MaxHeight="100" MaxWidth="440"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DetailGame.LogoPath}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DetailGame.LogoPath}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="{Binding DetailGame.DisplayName}" FontSize="32" FontWeight="Bold"
                                           Foreground="White" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DetailGame.LogoPath}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DetailGame.LogoPath}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#AABBCC" Margin="0,0,20,0">
                                    <Run Text="⏱" /><Run Text=" "/><Run Text="{Binding DetailGame.PlayTimeDisplay, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#AABBCC" Margin="0,0,20,0">
                                    <Run Text="🎮" /><Run Text=" "/><Run Text="{Binding DetailGame.GenresDisplay, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#FFD700">
                                    <Run Text="★" /><Run Text=" "/><Run Text="{Binding DetailGame.RatingDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding DetailGame.SummaryDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="#99AABB"
                                       TextWrapping="Wrap" MaxHeight="100" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#667788" Margin="0,0,24,0">
                                    <Run Text="Última vez:" /><Run Text=" "/><Run Text="{Binding DetailGame.LastPlayedText, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#667788" Text="{Binding DetailGame.PlatformSource}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>


                    <Border Grid.Column="1" VerticalAlignment="Stretch" Padding="22,16" CornerRadius="14" Margin="16,0,0,0">
                        <Border.Background>
                            <SolidColorBrush Color="#000000" Opacity="0.5"/>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="3" Opacity="0.4"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ctrl:ArcGauge Value="{Binding CpuUsage}" Label="CPU" Margin="6,0">
                                <ctrl:ArcGauge.LayoutTransform>
                                    <ScaleTransform ScaleX="1.65" ScaleY="1.65"/>
                                </ctrl:ArcGauge.LayoutTransform>
                            </ctrl:ArcGauge>
                            <ctrl:ArcGauge Value="{Binding GpuUsage}" Label="GPU" Margin="6,0">
                                <ctrl:ArcGauge.LayoutTransform>
                                    <ScaleTransform ScaleX="1.65" ScaleY="1.65"/>
                                </ctrl:ArcGauge.LayoutTransform>
                            </ctrl:ArcGauge>
                            <ctrl:ArcGauge Value="{Binding RamUsage}" Label="RAM" Margin="6,0">
                                <ctrl:ArcGauge.LayoutTransform>
                                    <ScaleTransform ScaleX="1.65" ScaleY="1.65"/>
                                </ctrl:ArcGauge.LayoutTransform>
                            </ctrl:ArcGauge>
                            <ctrl:ArcGauge Value="{Binding CpuTemp}" Label="CPU °C" IsTemperature="True" Margin="8,0">
                                <ctrl:ArcGauge.LayoutTransform>
                                    <ScaleTransform ScaleX="1.75" ScaleY="1.75"/>
                                </ctrl:ArcGauge.LayoutTransform>
                            </ctrl:ArcGauge>
                            <ctrl:ArcGauge Value="{Binding GpuTemp}" Label="GPU °C" IsTemperature="True" Margin="8,0">
                                <ctrl:ArcGauge.LayoutTransform>
                                    <ScaleTransform ScaleX="1.75" ScaleY="1.75"/>
                                </ctrl:ArcGauge.LayoutTransform>
                            </ctrl:ArcGauge>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Padding="30,18,30,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="0,2,0,2"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveZone}" Value="{x:Static vm:MainViewModel+NavZone.Carousel}">
                                    <Setter Property="BorderBrush" Value="#4400E676"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#44000010" Offset="0"/>
                            <GradientStop Color="#88080815" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <ListBox ItemsSource="{Binding GamesView}"
                     SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     x:Name="GameCarousel"
                     SelectionChanged="GameCarousel_SelectionChanged"
                     Padding="0,0,20,0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="10,18"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Grid.RenderTransform>
                                                    <Border x:Name="Glow" CornerRadius="13" Margin="-4"
                                                            BorderThickness="2.5" BorderBrush="{DynamicResource AccentBrush}" Opacity="0"
                                                            IsHitTestVisible="False">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#107C10" BlurRadius="20" ShadowDepth="0" Opacity="0.75"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <Border x:Name="Bd" Width="155" Height="210"
                                                            CornerRadius="10" ClipToBounds="True"
                                                            Background="#44000000" Cursor="Hand">
                                                        <Grid>
                                                            <Grid.Clip>
                                                                <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,155,210"/>
                                                            </Grid.Clip>
                                                            <ContentPresenter/>
                                                            <Border x:Name="Shine" CornerRadius="10" Opacity="0" IsHitTestVisible="False">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#20FFFFFF" Offset="0"/>
                                                                        <GradientStop Color="#00FFFFFF" Offset="0.35"/>
                                                                        <GradientStop Color="#08FFFFFF" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1.10" Duration="0:0:0.25">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1.10" Duration="0:0:0.25">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                      Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                      To="1.0" Duration="0:0:0.2" FillBehavior="Stop">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                      Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                      To="1.0" Duration="0:0:0.2" FillBehavior="Stop">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1.10" Duration="0:0:0.3">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1.10" Duration="0:0:0.3">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="Glow"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     To="1" Duration="0:0:0.35">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="Shine"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     To="1" Duration="0:0:0.4">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     To="1.0" Duration="0:0:0.2" FillBehavior="Stop">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     To="1.0" Duration="0:0:0.2" FillBehavior="Stop">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="Glow"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     To="0" Duration="0:0:0.2">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="Shine"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     To="0" Duration="0:0:0.15">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsBigPictureMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="LayoutTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.4" ScaleY="1.4"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Margin" Value="14,24"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="CardRoot" Background="#1A2533">
                                        <md:PackIcon Kind="GamepadVariant" Width="30" Height="30"
                                 Foreground="#334455" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="{Binding HasNoImage, Converter={StaticResource BoolToVisibility}}"/>
                                        <Image Source="{Binding EffectiveImagePath, Converter={StaticResource PathToImageConverter}, ConverterParameter=155}"
                           Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}"/>
                                        <md:PackIcon Kind="Star" Width="16" Height="16" Foreground="#FFD700"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                 Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}"
                                 CacheMode="BitmapCache">
                                            <md:PackIcon.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.7"/>
                                            </md:PackIcon.Effect>
                                        </md:PackIcon>
                                        <Border VerticalAlignment="Bottom" Padding="6,5" Background="#BB000000">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="10" FontWeight="SemiBold"
                                 Foreground="White" TextTrimming="CharacterEllipsis"
                                 HorizontalAlignment="Center" CacheMode="BitmapCache">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.8"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </Border>

                                        <Border x:Name="DarkOverlay" Background="#BB000000" Opacity="0" IsHitTestVisible="False"/>

                                        <Button x:Name="PlayBtn"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Cursor="Hand" BorderThickness="0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="PlayBd" CornerRadius="14" Padding="16,10"
                                                            Background="#E61A1A2E"
                                                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.2"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                        </Border.RenderTransform>
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#107C10" BlurRadius="24" ShadowDepth="0" Opacity="0.5"/>
                                                        </Border.Effect>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Data="M0,0 L12,8 0,16Z" Fill="{DynamicResource AccentBrush}" Width="10" Height="12"
                                                                  Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Text="JOGAR" FontSize="12" FontWeight="Bold"
                                                                       FontFamily="Segoe UI" Foreground="White" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="PlayBd" Property="Background" Value="#F01A1A2E"/>
                                                            <Setter TargetName="PlayBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter TargetName="PlayBd" Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#107C10" BlurRadius="32" ShadowDepth="0" Opacity="0.7"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter TargetName="PlayBd" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="PlayBd" Property="Background" Value="#F0151530"/>
                                                            <Setter TargetName="PlayBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter TargetName="PlayBd" Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#107C10" BlurRadius="18" ShadowDepth="0" Opacity="0.4"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter TargetName="PlayBd" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Grid.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="DarkOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="DarkOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Grid.Triggers>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Padding="50,12,50,14">
                    <Border.Background>
                        <SolidColorBrush Color="#0A0A12" Opacity="0.88"/>
                    </Border.Background>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ShowDetailPanel}" Value="True"/>
                                        <Condition Binding="{Binding IsBigPictureMode}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Detalhes" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="1" Opacity="0.7"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <Border Background="#88161622" CornerRadius="8" Padding="14,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="155"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Atividade Recente" FontSize="13" Foreground="#778899"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DetailGame.LastPlayedText}" FontSize="13" Foreground="#AABBCC"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="155"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tempo de Jogo" FontSize="13" Foreground="#778899"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DetailGame.PlayTimeDisplay}" FontSize="13" Foreground="#5599CC"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="155"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Local de instalação" FontSize="13" Foreground="#778899"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DetailGame.InstallDirectory}" FontSize="13"
                               Foreground="#5599CC" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DetailGame.InstallDirectory}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="155"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tamanho" FontSize="13" Foreground="#778899"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DetailGame.InstallSizeDisplay}" FontSize="13" Foreground="#5599CC"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="155"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Plataforma" FontSize="13" Foreground="#778899"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DetailGame.PlatformSource}" FontSize="13" Foreground="#5599CC"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="155"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Gênero" FontSize="13" Foreground="#778899"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DetailGame.GenresDisplay}" FontSize="13" Foreground="#5599CC" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="155"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Rating IGDB" FontSize="13" Foreground="#778899"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DetailGame.RatingDisplay}" FontSize="13" Foreground="#FFD700"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="155"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Lançamento" FontSize="13" Foreground="#778899"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DetailGame.YearDisplay}" FontSize="13" Foreground="#5599CC"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Descrição" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="1" Opacity="0.7"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <Border Background="#88161622" CornerRadius="8" Padding="14,10">
                                <TextBlock Text="{Binding DetailGame.SummaryDisplay}" FontSize="13"
                           Foreground="#AABBCC" TextWrapping="Wrap" LineHeight="20"
                           MaxHeight="160" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tecnologias / GPU" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="1" Opacity="0.7"/>
                                    </TextBlock.Effect>
                                </TextBlock>

                                <Button Grid.Column="1" Command="{Binding OpenHwRecommendationCommand}"
                                        Cursor="Hand" BorderThickness="0" Background="Transparent"
                                        Padding="0" ToolTip="Análise de Hardware — Recomendação Gráfica"
                                        VerticalAlignment="Center" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="Chip" Width="18" Height="18" Foreground="#00E676" VerticalAlignment="Center"/>
                                        <TextBlock Text="Meu computador roda este game?" FontSize="16" FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding RescanGameTechCommand}"
                                        Cursor="Hand" BorderThickness="0" Background="Transparent"
                                        Padding="0" ToolTip="Re-escanear tecnologias" VerticalAlignment="Center">
                                    <md:PackIcon Kind="Refresh" Width="16" Height="16" Foreground="#556677"/>
                                </Button>
                            </Grid>
                            <Border Background="#88161622" CornerRadius="8" Padding="14,10">
                                <StackPanel>
                                    <TextBlock FontSize="11" Foreground="#556677" Margin="0,0,0,8"
                                               Text="{Binding GpuName, StringFormat='GPU: {0}'}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <ItemsControl ItemsSource="{Binding TechCompatItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <md:PackIcon Kind="{Binding IconKind}" Width="16" Height="16"
                                                                 Foreground="#8899AA" VerticalAlignment="Center"
                                                                 Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TechName}" FontSize="12"
                                                                   FontWeight="SemiBold" Foreground="#CCDDEE"/>
                                                        <TextBlock Text="{Binding Detail}" FontSize="10"
                                                                   Foreground="#778899"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" CornerRadius="8" Padding="8,3"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#33FFD740"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusColor}" Value="#00E676">
                                                                        <Setter Property="Background" Value="#3300E676"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusColor}" Value="#FF5252">
                                                                        <Setter Property="Background" Value="#33FF5252"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                                   FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#FFD740"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StatusColor}" Value="#00E676">
                                                                            <Setter Property="Foreground" Value="#00E676"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusColor}" Value="#FF5252">
                                                                            <Setter Property="Foreground" Value="#FF5252"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock FontSize="12" Foreground="#556677" HorizontalAlignment="Center"
                                               Margin="0,4,0,0"
                                               Text="Nenhuma tecnologia detectada">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TechCompatItems.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="3" Background="{DynamicResource HeaderBackgroundBrush}" Padding="20,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBigPictureMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#888888" FontSize="12"/>
                    <TextBlock Text="{Binding GamepadStatus}" FontSize="10" Foreground="#00E676" Margin="0,2,0,0"
                               Visibility="{Binding GamepadConnected, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="Desenvolvido por Kleber Freitas" Foreground="#666688" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" FontSize="10" Foreground="#556677" FontWeight="SemiBold" Margin="0,1,10,1" VerticalAlignment="Center"><Run Text="Processador"/><Run Language="pt-br" Text=":"/></TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CpuName}" FontSize="10" Foreground="#8899AA" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="320"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" FontSize="10" Foreground="#556677" FontWeight="SemiBold" Margin="0,1,10,1" VerticalAlignment="Center"><Run Text="Placa de Vídeo"/><Run Language="pt-br" Text=":"/></TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuName}" FontSize="10" Foreground="#8899AA" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="320"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" FontSize="10" Foreground="#556677" FontWeight="SemiBold" Margin="0,1,10,1" VerticalAlignment="Center"><Run Text="Memória"/><Run Language="pt-br" Text=":"/></TextBlock>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RamTotal}" FontSize="10" Foreground="#8899AA" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" FontSize="10" Foreground="#556677" FontWeight="SemiBold" Margin="0,1,10,1" VerticalAlignment="Top"><Run Text="Armazenamento"/><Run Language="pt-br" Text=":"/></TextBlock>
                        <ItemsControl Grid.Row="3" Grid.Column="1" ItemsSource="{Binding StorageDrives}" VerticalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="10" Foreground="#8899AA" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <ctrl:ArcGauge Value="{Binding CpuUsage}" Label="CPU" Margin="2,0">
                        <ctrl:ArcGauge.LayoutTransform>
                            <ScaleTransform ScaleX="0.85" ScaleY="0.85"/>
                        </ctrl:ArcGauge.LayoutTransform>
                    </ctrl:ArcGauge>
                    <ctrl:ArcGauge Value="{Binding GpuUsage}" Label="GPU" Margin="2,0">
                        <ctrl:ArcGauge.LayoutTransform>
                            <ScaleTransform ScaleX="0.85" ScaleY="0.85"/>
                        </ctrl:ArcGauge.LayoutTransform>
                    </ctrl:ArcGauge>
                    <ctrl:ArcGauge Value="{Binding RamUsage}" Label="RAM" Margin="2,0">
                        <ctrl:ArcGauge.LayoutTransform>
                            <ScaleTransform ScaleX="0.85" ScaleY="0.85"/>
                        </ctrl:ArcGauge.LayoutTransform>
                    </ctrl:ArcGauge>
                    <ctrl:ArcGauge Value="{Binding CpuTemp}" Label="CPU °C" IsTemperature="True" Margin="4,0">
                        <ctrl:ArcGauge.LayoutTransform>
                            <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                        </ctrl:ArcGauge.LayoutTransform>
                    </ctrl:ArcGauge>
                    <ctrl:ArcGauge Value="{Binding GpuTemp}" Label="GPU °C" IsTemperature="True" Margin="4,0">
                        <ctrl:ArcGauge.LayoutTransform>
                            <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                        </ctrl:ArcGauge.LayoutTransform>
                    </ctrl:ArcGauge>
                </StackPanel>
            </Grid>
        </Border>


        <Border x:Name="DragGhost" Grid.RowSpan="4"
                Width="155" Height="210" CornerRadius="10"
                Opacity="0.75" IsHitTestVisible="False"
                Visibility="Collapsed" Panel.ZIndex="9999"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect x:Name="DragGhostGlow" Color="#107C10" BlurRadius="28" ShadowDepth="0" Opacity="0.9"/>
            </Border.Effect>
            <Image x:Name="DragGhostImage" Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Clip>
                    <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,155,210"/>
                </Image.Clip>
            </Image>
        </Border>


        <Border x:Name="DropIndicator" Grid.RowSpan="4"
                Width="3" IsHitTestVisible="False"
                Visibility="Collapsed" Panel.ZIndex="9998"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{DynamicResource AccentBrush}">
            <Border.Effect>
                <DropShadowEffect x:Name="DropIndicatorGlow" Color="#107C10" BlurRadius="8" ShadowDepth="0" Opacity="1"/>
            </Border.Effect>
        </Border>


        <Grid x:Name="BpTransitionOverlay"
              Grid.RowSpan="4"
              Panel.ZIndex="10000"
              IsHitTestVisible="False"
              Visibility="Collapsed">


            <Border x:Name="BpFlash"
                    Background="White"
                    Opacity="0"/>


            <Border x:Name="BpVignette" Opacity="0">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                        <GradientStop Color="Transparent"  Offset="0.0"/>
                        <GradientStop Color="Transparent"  Offset="0.4"/>
                        <GradientStop Color="#CC000000"    Offset="0.75"/>
                        <GradientStop Color="#FF000000"    Offset="1.0"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>


            <ItemsControl x:Name="BpScanLines" Opacity="0" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>


            <Grid x:Name="BpLogoContainer"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Opacity="0"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="BpLogoScale" ScaleX="0.3" ScaleY="0.3"/>
                </Grid.RenderTransform>
                <Grid.Effect>
                    <DropShadowEffect x:Name="BpLogoGlow"
                                      Color="#107C10"
                                      BlurRadius="60"
                                      ShadowDepth="0"
                                      Opacity="0"/>
                </Grid.Effect>


                <Ellipse x:Name="BpLogoBg"
                         Width="200" Height="200"
                         Fill="#CC000000"
                         Stroke="{DynamicResource AccentBrush}"
                         StrokeThickness="2"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="BpPulseScale" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>


                <md:PackIcon Kind="TelevisionPlay"
                             Width="80" Height="80"
                             Foreground="{DynamicResource AccentBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="0,0,0,10"/>


                <TextBlock Text="BIG  PICTURE"
                           FontSize="16"
                           FontWeight="Bold"
                           FontFamily="Segoe UI"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,36"/>
            </Grid>


            <Border x:Name="BpBarLeft"
                    HorizontalAlignment="Left"
                    Width="0"
                    Background="{DynamicResource AccentBrush}"
                    Opacity="0.85"/>
            <Border x:Name="BpBarRight"
                    HorizontalAlignment="Right"
                    Width="0"
                    Background="{DynamicResource AccentBrush}"
                    Opacity="0.85"/>


            <Border x:Name="BpFadeOut"
                    Background="Black"
                    Opacity="0"/>
        </Grid>
    </Grid>
</Window>

