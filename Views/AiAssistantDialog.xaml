<Window x:Class="GameLauncher.Views.AiAssistantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:GameLauncher.Models"
        Title="GLauncher AI" Height="640" Width="480"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="CornerRadius" Value="16,4,16,16"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="60,4,4,4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="320"/>
        </Style>
        
        <Style x:Key="AiBubble" TargetType="Border">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="CornerRadius" Value="4,16,16,16"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="4,4,60,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="340"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0D0D1A" CornerRadius="16"
            BorderBrush="#2A2A4A" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="8" Opacity="0.7"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            
            <Border Grid.Row="0" Background="#16163A" CornerRadius="16,16,0,0"
                    Padding="16,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="10"
                                Width="36" Height="36" Margin="0,0,10,0">
                            <md:PackIcon Kind="Robot" Width="20" Height="20"
                                         Foreground="White" HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="GLauncher AI" FontSize="14" FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock x:Name="TxtGameContext" FontSize="11"
                                       Foreground="#8899BB" Text="Assistente Gamer"/>
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Click="Close_Click"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Padding="4" ToolTip="Fechar">
                        <md:PackIcon Kind="Close" Width="18" Height="18" Foreground="#8899BB"/>
                    </Button>
                </Grid>
            </Border>

            
            <ScrollViewer x:Name="MessagesScroll" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8,8">
                <ItemsControl x:Name="MessagesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:AiChatMessage}">
                            <Grid>
                                
                                <Border Style="{StaticResource UserBubble}"
                                        Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <TextBlock Text="{Binding Text}" Foreground="White"
                                               TextWrapping="Wrap" FontSize="13"/>
                                </Border>
                                
                                <Border Style="{StaticResource AiBubble}"
                                        Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" Foreground="#DDE1FF"
                                                   TextWrapping="Wrap" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            
            <Border x:Name="TypingIndicator" Grid.Row="2"
                    Visibility="Collapsed" Margin="12,0,0,4"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="#7C4DFF" Margin="2"/>
                    <Ellipse Width="6" Height="6" Fill="#7C4DFF" Margin="2"/>
                    <Ellipse Width="6" Height="6" Fill="#7C4DFF" Margin="2"/>
                    <TextBlock Text=" digitando..." Foreground="#8899BB" FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            
            <Border Grid.Row="3" Background="#16163A" CornerRadius="0"
                    Padding="10,10">
                <Grid>
                     <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="Auto"/>
                         <ColumnDefinition Width="Auto"/>
                         <ColumnDefinition Width="*"/>
                         <ColumnDefinition Width="Auto"/>
                     </Grid.ColumnDefinitions>
                    
                    <Button x:Name="BtnKeyboard" Grid.Column="0"
                            Click="ToggleKeyboard_Click" ToolTip="Teclado Virtual (X)"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Padding="6" Margin="0,0,4,0">
                        <md:PackIcon x:Name="IconKeyboard" Kind="Keyboard" Width="22" Height="22"
                                     Foreground="#8899BB"/>
                    </Button>

                    
                    <Button x:Name="BtnScreenshot" Grid.Column="1"
                            Click="Screenshot_Click" ToolTip="Analisar Screenshot"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Padding="6" Margin="0,0,6,0">
                        <md:PackIcon Kind="ImageSearch" Width="22" Height="22"
                                     Foreground="#8899BB"/>
                    </Button>

                    
                    <Border Grid.Column="2" Background="#0D0D1A" CornerRadius="12"
                            Padding="12,8">
                        <TextBox x:Name="InputBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="White" FontSize="13" CaretBrush="White"
                                 TextWrapping="Wrap" MaxLines="4" AcceptsReturn="False"
                                 VerticalContentAlignment="Center"
                                 PreviewKeyDown="InputBox_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Resources>
                                        <VisualBrush x:Key="Watermark" TileMode="None"
                                                     Opacity="0.4" Stretch="None"
                                                     AlignmentX="Left">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="Pergunte algo sobre o jogo..."
                                                           Foreground="White" FontSize="13"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{StaticResource Watermark}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    
                    <Button x:Name="BtnSend" Grid.Column="3"
                            Click="Send_Click" Cursor="Hand"
                            Margin="6,0,0,0" Padding="10"
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="12"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <md:PackIcon Kind="Send" Width="18" Height="18" Foreground="White"/>
                    </Button>
                </Grid>
            </Border>

            
            <Border Grid.Row="4" Background="#0D0D16" CornerRadius="0,0,16,16" Padding="10,6">
                <Grid>
                    
                    <StackPanel x:Name="HintsGamepad" Orientation="Horizontal"
                                HorizontalAlignment="Center" Visibility="Collapsed">
                        <md:PackIcon Kind="Gamepad" Width="14" Height="14" Foreground="#8899BB"
                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Border Background="#2A2A4A" CornerRadius="4" Padding="5,1" Margin="0,0,2,0">
                            <TextBlock x:Name="HintBadgeA" Text="A" FontSize="10" FontWeight="Bold"
                                       Foreground="#00E676" FontFamily="Consolas"/>
                        </Border>
                        <TextBlock Text=" Enviar  " FontSize="10" Foreground="#8899BB" VerticalAlignment="Center"/>
                        <Border Background="#2A2A4A" CornerRadius="4" Padding="5,1" Margin="0,0,2,0">
                            <TextBlock x:Name="HintBadgeX" Text="X" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas"/>
                        </Border>
                        <TextBlock Text=" Teclado  " FontSize="10" Foreground="#8899BB" VerticalAlignment="Center"/>
                        <Border Background="#2A2A4A" CornerRadius="4" Padding="5,1" Margin="0,0,2,0">
                            <TextBlock x:Name="HintBadgeY" Text="Y" FontSize="10" FontWeight="Bold"
                                       Foreground="#FFD740" FontFamily="Consolas"/>
                        </Border>
                        <TextBlock Text=" Screenshot  " FontSize="10" Foreground="#8899BB" VerticalAlignment="Center"/>
                        <Border Background="#2A2A4A" CornerRadius="4" Padding="5,1" Margin="0,0,2,0">
                            <TextBlock x:Name="HintBadgeB" Text="B" FontSize="10" FontWeight="Bold"
                                       Foreground="#FF5252" FontFamily="Consolas"/>
                        </Border>
                        <TextBlock Text=" Fechar" FontSize="10" Foreground="#8899BB" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel x:Name="HintsKeyboard" Orientation="Horizontal"
                                HorizontalAlignment="Center" Visibility="Visible">
                        <md:PackIcon Kind="Keyboard" Width="14" Height="14" Foreground="#8899BB"
                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Border Background="#2A2A4A" CornerRadius="4" Padding="5,1" Margin="0,0,2,0">
                            <TextBlock Text="Enter" FontSize="10" FontWeight="Bold"
                                       Foreground="#00E676" FontFamily="Consolas"/>
                        </Border>
                        <TextBlock Text=" Enviar  " FontSize="10" Foreground="#8899BB" VerticalAlignment="Center"/>
                        <Border Background="#2A2A4A" CornerRadius="4" Padding="5,1" Margin="0,0,2,0">
                            <TextBlock Text="Esc" FontSize="10" FontWeight="Bold"
                                       Foreground="#FF5252" FontFamily="Consolas"/>
                        </Border>
                        <TextBlock Text=" Fechar" FontSize="10" Foreground="#8899BB" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

