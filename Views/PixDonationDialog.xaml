<Window x:Class="GameLauncher.Views.PixDonationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="&#x1f3ae; Apoie o GLauncher"
        Width="480" Height="750"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0A0A12"
        TextElement.Foreground="White"
        TextElement.FontFamily="Segoe UI">
    <Grid>
        
        <Border VerticalAlignment="Top" Height="200">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.8" RadiusX="0.8" RadiusY="1.2">
                    <GradientStop Color="#2200E676" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" Margin="24,24,24,20">
                
                <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Ellipse Width="56" Height="56" Fill="#14FFB300">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#FFB300" BlurRadius="30" ShadowDepth="0" Opacity="0.4"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="&#x1f3c6;" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                
                <TextBlock Text="APOIE O PROJETO" FontSize="20" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,4,0,2">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00E676" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Sua doação mantém o GLauncher vivo!" FontSize="12" Foreground="#88AACC"
                           HorizontalAlignment="Center" Margin="0,0,0,18"/>

                
                <Border Background="#0E1525" CornerRadius="12" Padding="16,14" Margin="0,0,0,16"
                        BorderBrush="#1A2545" BorderThickness="1" MaxWidth="400">
                    <StackPanel>
                        <TextBlock Text="O QUE VOCÊ AJUDA A MANTER" FontSize="11" FontWeight="Bold"
                                   Foreground="#00E676" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <md:PackIcon Kind="GamepadVariant" Width="18" Height="18" Foreground="#00E676"
                                         VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Interface estilo PS5" FontSize="12" FontWeight="SemiBold" Foreground="#DDDDEE"/>
                                <TextBlock Text="Launcher moderno com visual de console" FontSize="10.5" Foreground="#667788"/>
                            </StackPanel>
                        </StackPanel>

                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <md:PackIcon Kind="Store" Width="18" Height="18" Foreground="#448AFF"
                                         VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Steam, Xbox, Epic Games e jogos locais" FontSize="12" FontWeight="SemiBold" Foreground="#DDDDEE"/>
                                <TextBlock Text="Todos os seus jogos em um só lugar" FontSize="10.5" Foreground="#667788"/>
                            </StackPanel>
                        </StackPanel>

                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <md:PackIcon Kind="ImageSearch" Width="18" Height="18" Foreground="#FFB300"
                                         VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Capas, logos e backgrounds automáticos" FontSize="12" FontWeight="SemiBold" Foreground="#DDDDEE"/>
                                <TextBlock Text="Artes baixadas da IGDB e SteamGridDB" FontSize="10.5" Foreground="#667788"/>
                            </StackPanel>
                        </StackPanel>

                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <md:PackIcon Kind="Chip" Width="18" Height="18" Foreground="#B388FF"
                                         VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Monitoramento de hardware em tempo real" FontSize="12" FontWeight="SemiBold" Foreground="#DDDDEE"/>
                                <TextBlock Text="CPU, GPU, RAM e temperaturas" FontSize="10.5" Foreground="#667788"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                
                <Border Background="#151B2E" CornerRadius="10" Padding="14,12" HorizontalAlignment="Center"
                        Margin="0,0,0,12" MinWidth="340">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#x1f4b3;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Doe via PIX" FontSize="14" FontWeight="Bold" Foreground="#00E676"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Copie a chave abaixo e cole no app do seu banco" FontSize="11" Foreground="#667788"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                
                <Border Background="#0D1220" CornerRadius="8" Padding="14,8" HorizontalAlignment="Center"
                        Margin="0,0,0,10" MinWidth="340" BorderBrush="#1A2040" BorderThickness="1">
                    <TextBlock Text="freitas.kleber@uol.com.br" FontSize="12.5" Foreground="#8899BB"
                               HorizontalAlignment="Center" FontFamily="Consolas"/>
                </Border>

                
                <Button x:Name="CopyButton" Click="CopyKey_Click" Cursor="Hand"
                        HorizontalAlignment="Center" Margin="0,0,0,14" Height="47">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CopyBd" Background="#1A2040" CornerRadius="22" Padding="20,10"
                                    BorderBrush="#2A3060" BorderThickness="1" MinWidth="340">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <md:PackIcon Kind="ContentCopy" Width="16" Height="16" Foreground="#88AACC"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="CopyText" Text="Copiar chave PIX" FontSize="13"
                                               FontWeight="SemiBold" Foreground="#AABBDD" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CopyBd" Property="Background" Value="#222B50"/>
                                    <Setter TargetName="CopyBd" Property="BorderBrush" Value="#00E676"/>
                                    <Setter TargetName="CopyText" Property="Foreground" Value="#00E676"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CopyBd" Property="Background" Value="#1A2540"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                
                <Border Background="#0E1420" CornerRadius="8" Padding="12,8" HorizontalAlignment="Center"
                        MinWidth="340">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#x2764;&#xfe0f;" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Obrigado por apoiar um dev indie!" FontSize="12" Foreground="#AABBCC"
                                   FontStyle="Italic" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
