<Window x:Class="GameLauncher.Views.DiscordPanelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="&#x1f3ae; Discord Panel"
        Width="760" Height="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0D0D15"
        TextElement.Foreground="White"
        TextElement.FontFamily="Segoe UI">
    <Grid>
        <Border VerticalAlignment="Top" Height="60">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#5865F2" Offset="0"/>
                    <GradientStop Color="#0D0D15" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <md:PackIcon Kind="MessageText" Width="24" Height="24" Foreground="#5865F2"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="DISCORD PANEL" FontSize="18" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#5865F2" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <!-- Tab bar -->
            <Border Grid.Row="1" Background="#11FFFFFF" CornerRadius="8" Padding="4"
                    HorizontalAlignment="Center" Margin="0,0,0,12">
                <StackPanel x:Name="TabBar" Orientation="Horizontal">
                    <Border x:Name="TabVoice" CornerRadius="6" Padding="16,8" Margin="2,0"
                            Background="#5865F2" Cursor="Hand" MouseLeftButtonUp="Tab_Click" Tag="0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Microphone" Width="16" Height="16" Foreground="White"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="VOZ" FontSize="12" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="TabMessages" CornerRadius="6" Padding="16,8" Margin="2,0"
                            Background="#22FFFFFF" Cursor="Hand" MouseLeftButtonUp="Tab_Click" Tag="1">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="MessageReply" Width="16" Height="16" Foreground="#8899AA"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="MENSAGENS" FontSize="12" FontWeight="Bold" Foreground="#8899AA"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="TabNotifications" CornerRadius="6" Padding="16,8" Margin="2,0"
                            Background="#22FFFFFF" Cursor="Hand" MouseLeftButtonUp="Tab_Click" Tag="2">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Bell" Width="16" Height="16" Foreground="#8899AA"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="NOTIFICAÇÕES" FontSize="12" FontWeight="Bold" Foreground="#8899AA"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Content area -->
            <Grid Grid.Row="2" Margin="24,0,24,0">

                <!-- Voice Tab -->
                <Grid x:Name="VoicePanel" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Channel list -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="🔊 Canais de Voz" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#CCDDEE" Margin="0,0,0,8"/>
                        <Border Background="#151B2E" CornerRadius="10" Padding="6" MinHeight="280">
                            <ListBox x:Name="ChannelList" Background="Transparent" BorderThickness="0"
                                     SelectionChanged="ChannelList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="2"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="8" Padding="12,10"
                                                            Background="Transparent" Cursor="Hand">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#335865F2"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5865F2"/>
                                                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="VolumeHigh" Width="16" Height="16"
                                                         Foreground="#5865F2" VerticalAlignment="Center"
                                                         Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       Foreground="#CCDDEE" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Guild selector -->
                        <Border Background="#151B2E" CornerRadius="8" Padding="8,6" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Servidor:" FontSize="10" Foreground="#556677" Margin="0,0,0,4"/>
                                <ComboBox x:Name="GuildCombo" Background="#1A2040"
                                          Foreground="White" FontSize="12"
                                          SelectionChanged="GuildCombo_SelectionChanged"
                                          DisplayMemberPath="Name"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Voice status + controls -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="🎙️ Controles de Voz" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#CCDDEE" Margin="0,0,0,8"/>

                        <!-- Current channel -->
                        <Border Grid.Row="1" Background="#151B2E" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Canal Atual" FontSize="10" Foreground="#556677" Margin="0,0,0,2"/>
                                <TextBlock x:Name="CurrentChannelText" Text="Nenhum"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#5865F2"/>
                            </StackPanel>
                        </Border>

                        <!-- Mute / Deafen buttons -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnMute" Click="BtnMute_Click" Grid.Column="0"
                                    Cursor="Hand" BorderThickness="0" Height="80">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="MuteBd" CornerRadius="10" Padding="10"
                                                Background="#1A2040" BorderBrush="#2A3060" BorderThickness="1">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <md:PackIcon x:Name="MuteIcon" Kind="Microphone"
                                                             Width="30" Height="30" Foreground="#00E676"
                                                             HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="MuteLabel" Text="[Y] MUTAR"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="#8899AA" HorizontalAlignment="Center"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MuteBd" Property="BorderBrush" Value="#5865F2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="BtnDeafen" Click="BtnDeafen_Click" Grid.Column="2"
                                    Cursor="Hand" BorderThickness="0" Height="80">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="DeafBd" CornerRadius="10" Padding="10"
                                                Background="#1A2040" BorderBrush="#2A3060" BorderThickness="1">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <md:PackIcon x:Name="DeafIcon" Kind="Headphones"
                                                             Width="30" Height="30" Foreground="#00E676"
                                                             HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="DeafLabel" Text="[X] SILENCIAR"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="#8899AA" HorizontalAlignment="Center"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DeafBd" Property="BorderBrush" Value="#5865F2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Users in channel -->
                        <Border Grid.Row="3" Background="#151B2E" CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="No Canal:" FontSize="10" Foreground="#556677" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="VoiceUsersList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <TextBlock Text="{Binding StatusIcon}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                           Foreground="#CCDDEE" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoUsersText" Text="Ninguém no canal"
                                           FontSize="11" Foreground="#556677" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Join/Leave -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnJoin" Click="BtnJoin_Click" Grid.Column="0"
                                    Cursor="Hand" BorderThickness="0" Height="44">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="10" Padding="16,10" Background="#225865F2"
                                                BorderBrush="#5865F2" BorderThickness="1">
                                            <TextBlock Text="[A] ENTRAR" FontSize="13" FontWeight="Bold"
                                                       Foreground="#5865F2" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="BtnLeave" Click="BtnLeave_Click" Grid.Column="2"
                                    Cursor="Hand" BorderThickness="0" Height="44">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="10" Padding="16,10" Background="#22FF5252"
                                                BorderBrush="#FF5252" BorderThickness="1">
                                            <TextBlock Text="[B] SAIR" FontSize="13" FontWeight="Bold"
                                                       Foreground="#FF5252" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Messages Tab -->
                <Grid x:Name="MessagesPanel" Visibility="Collapsed">
                    <StackPanel MaxWidth="400" HorizontalAlignment="Center">
                        <TextBlock Text="💬 Mensagens Rápidas" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#CCDDEE" Margin="0,0,0,4"/>
                        <TextBlock Text="Envie para o canal do webhook configurado"
                                   FontSize="11" Foreground="#556677" Margin="0,0,0,12"/>

                        <Border Background="#151B2E" CornerRadius="10" Padding="8" Margin="0,0,0,12">
                            <ListBox x:Name="QuickMessagesList" Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="2"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="8" Padding="14,10"
                                                            Background="Transparent" Cursor="Hand">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#335865F2"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5865F2"/>
                                                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▸" Foreground="#5865F2" FontSize="13"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding}" FontSize="13"
                                                       Foreground="#CCDDEE" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Button x:Name="BtnSendMsg" Click="BtnSendMsg_Click"
                                Cursor="Hand" BorderThickness="0" HorizontalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="10" Padding="24,10" Background="#225865F2"
                                            BorderBrush="#5865F2" BorderThickness="1">
                                        <TextBlock Text="[A] ENVIAR MENSAGEM" FontSize="12" FontWeight="Bold"
                                                   Foreground="#5865F2" HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock x:Name="MsgStatusText" Text="" FontSize="11" Foreground="#00E676"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>

                        <!-- Webhook config -->
                        <Border Background="#151B2E" CornerRadius="8" Padding="10,8" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Webhook URL:" FontSize="10" Foreground="#556677" Margin="0,0,0,4"/>
                                <TextBox x:Name="WebhookUrlBox" FontSize="11" Foreground="#AABBCC"
                                         Background="#1A2040" BorderBrush="#2A3060" Padding="8,6"
                                         TextChanged="WebhookUrlBox_TextChanged"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Notifications Tab -->
                <Grid x:Name="NotificationsPanel" Visibility="Collapsed">
                    <StackPanel MaxWidth="480" HorizontalAlignment="Center">
                        <TextBlock Text="🔔 Notificações" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#CCDDEE" Margin="0,0,0,12"/>

                        <Border Background="#151B2E" CornerRadius="10" Padding="10" MinHeight="300">
                            <StackPanel>
                                <ItemsControl x:Name="NotificationsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#11FFFFFF" CornerRadius="8"
                                                    Padding="12,8" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="12"
                                                               FontWeight="SemiBold" Foreground="#CCDDEE"/>
                                                    <TextBlock Text="{Binding Body}" FontSize="11"
                                                               Foreground="#8899AA" TextWrapping="Wrap"
                                                               Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding TimeText}" FontSize="9"
                                                               Foreground="#445566" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoNotificationsText"
                                           Text="Nenhuma notificação ainda..."
                                           FontSize="12" Foreground="#556677"
                                           HorizontalAlignment="Center" Margin="0,20,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Footer hints -->
            <Border Grid.Row="3" Padding="16,8" Background="#08FFFFFF">
                <TextBlock x:Name="HintText"
                           FontSize="10" Foreground="#556677" HorizontalAlignment="Center"><Run Text="[LB/RB] Trocar aba  |  [A] Selecionar  |  [B] Fechar  |  [Y] Mut"/><Run Language="pt-br" Text="ar"/><Run Text="  |  [X] Silenciar  |  ⬆⬇ Navegar"/></TextBlock>
            </Border>
        </Grid>
    </Grid>
</Window>
