<Window x:Class="GameLauncher.Views.DiscordPanelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="&#x1f3ae; Discord Panel"
        Width="760" Height="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0D0D15"
        TextElement.Foreground="White"
        TextElement.FontFamily="Segoe UI">
    <Grid>
        <Border VerticalAlignment="Top" Height="60">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#5865F2" Offset="0"/>
                    <GradientStop Color="#0D0D15" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <md:PackIcon Kind="MessageText" Width="24" Height="24" Foreground="#5865F2"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="DISCORD PANEL" FontSize="18" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#5865F2" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
                <Button x:Name="BtnLogout" Click="BtnLogout_Click" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="LogoutBd" CornerRadius="6" Padding="10,4" Background="#22FF5252"
                                    BorderBrush="#FF5252" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Logout" Width="14" Height="14" Foreground="#FF5252"
                                                 VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="DESCONECTAR" FontSize="10" FontWeight="Bold"
                                               Foreground="#FF5252" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="LogoutBd" Property="Background" Value="#44FF5252"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            
            <Border Grid.Row="1" Background="#11FFFFFF" CornerRadius="8" Padding="4"
                    HorizontalAlignment="Center" Margin="0,0,0,12">
                <StackPanel x:Name="TabBar" Orientation="Horizontal">
                    <Border x:Name="TabVoice" CornerRadius="6" Padding="16,8" Margin="2,0"
                            Background="#5865F2" Cursor="Hand" MouseLeftButtonUp="Tab_Click" Tag="0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Microphone" Width="16" Height="16" Foreground="White"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="VOZ" FontSize="12" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="TabMessages" CornerRadius="6" Padding="16,8" Margin="2,0"
                            Background="#22FFFFFF" Cursor="Hand" MouseLeftButtonUp="Tab_Click" Tag="1">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="MessageReply" Width="16" Height="16" Foreground="#8899AA"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="MENSAGENS" FontSize="12" FontWeight="Bold" Foreground="#8899AA"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="TabNotifications" CornerRadius="6" Padding="16,8" Margin="2,0"
                            Background="#22FFFFFF" Cursor="Hand" MouseLeftButtonUp="Tab_Click" Tag="2">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Bell" Width="16" Height="16" Foreground="#8899AA"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="NOTIFICAÇÕES" FontSize="12" FontWeight="Bold" Foreground="#8899AA"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            
            <Grid Grid.Row="2" Margin="24,0,24,0">

                
                <Grid x:Name="VoicePanel" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="🔊 Canais de Voz" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#CCDDEE" Margin="0,0,0,8"/>
                        <Border Background="#151B2E" CornerRadius="10" Padding="6" MinHeight="280">
                            <ListBox x:Name="ChannelList" Background="Transparent" BorderThickness="0"
                                     SelectionChanged="ChannelList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="2"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="8" Padding="12,10"
                                                            Background="Transparent" Cursor="Hand">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#335865F2"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5865F2"/>
                                                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="VolumeHigh" Width="16" Height="16"
                                                         Foreground="#5865F2" VerticalAlignment="Center"
                                                         Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       Foreground="#CCDDEE" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        
                        <Border Background="#151B2E" CornerRadius="8" Padding="8,6" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Servidor:" FontSize="10" Foreground="#556677" Margin="0,0,0,4"/>
                                <ComboBox x:Name="GuildCombo" Background="#1A2040"
                                          Foreground="White" FontSize="12"
                                          SelectionChanged="GuildCombo_SelectionChanged"
                                          DisplayMemberPath="Name"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="🎙️ Controles de Voz" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#CCDDEE" Margin="0,0,0,8"/>

                        
                        <Border Grid.Row="1" Background="#151B2E" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Canal Atual" FontSize="10" Foreground="#556677" Margin="0,0,0,2"/>
                                <TextBlock x:Name="CurrentChannelText" Text="Nenhum"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#5865F2"/>
                            </StackPanel>
                        </Border>

                        
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnMute" Click="BtnMute_Click" Grid.Column="0"
                                    Cursor="Hand" BorderThickness="0" Height="80">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="MuteBd" CornerRadius="10" Padding="10"
                                                Background="#1A2040" BorderBrush="#2A3060" BorderThickness="1">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <md:PackIcon x:Name="MuteIcon" Kind="Microphone"
                                                             Width="30" Height="30" Foreground="#00E676"
                                                             HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="MuteLabel" Text="[Y] MUTAR"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="#8899AA" HorizontalAlignment="Center"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MuteBd" Property="BorderBrush" Value="#5865F2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="BtnDeafen" Click="BtnDeafen_Click" Grid.Column="2"
                                    Cursor="Hand" BorderThickness="0" Height="80">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="DeafBd" CornerRadius="10" Padding="10"
                                                Background="#1A2040" BorderBrush="#2A3060" BorderThickness="1">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <md:PackIcon x:Name="DeafIcon" Kind="Headphones"
                                                             Width="30" Height="30" Foreground="#00E676"
                                                             HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="DeafLabel" Text="[X] SILENCIAR"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="#8899AA" HorizontalAlignment="Center"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DeafBd" Property="BorderBrush" Value="#5865F2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        
                        <Border Grid.Row="3" Background="#151B2E" CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="No Canal:" FontSize="10" Foreground="#556677" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="VoiceUsersList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <TextBlock Text="{Binding StatusIcon}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                           Foreground="#CCDDEE" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoUsersText" Text="Ninguém no canal"
                                           FontSize="11" Foreground="#556677" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnJoin" Click="BtnJoin_Click" Grid.Column="0"
                                    Cursor="Hand" BorderThickness="0" Height="44">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="10" Padding="16,10" Background="#225865F2"
                                                BorderBrush="#5865F2" BorderThickness="1">
                                            <TextBlock Text="[A] ENTRAR" FontSize="13" FontWeight="Bold"
                                                       Foreground="#5865F2" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="BtnLeave" Click="BtnLeave_Click" Grid.Column="2"
                                    Cursor="Hand" BorderThickness="0" Height="44">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="10" Padding="16,10" Background="#22FF5252"
                                                BorderBrush="#FF5252" BorderThickness="1">
                                            <TextBlock Text="[B] SAIR" FontSize="13" FontWeight="Bold"
                                                       Foreground="#FF5252" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>

                
                <Grid x:Name="MessagesPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    
                    <TextBlock Grid.Row="0" Text="&#x1f4ac; Mensagens Diretas" FontSize="14" FontWeight="SemiBold"
                               Foreground="#CCDDEE" Margin="0,0,0,8"/>

                    <Grid Grid.Row="1">
                        <ProgressBar x:Name="DmLoadingBar" IsIndeterminate="True" Height="4"
                                     Foreground="#5865F2" Background="#22FFFFFF"
                                     VerticalAlignment="Top" Visibility="Collapsed"/>

                        <Border Background="#151B2E" CornerRadius="10" Padding="6" Margin="0,8,0,0">
                            <ListBox x:Name="DmChannelsList" Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="8" Padding="10,8"
                                                            Background="Transparent" Cursor="Hand">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#335865F2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                    ClipToBounds="True" Background="#2A3050"
                                                    Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Grid>
                                                    <md:PackIcon Kind="AccountGroup" Width="20" Height="20"
                                                                 Foreground="#556677" HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center">
                                                        <md:PackIcon.Style>
                                                            <Style TargetType="md:PackIcon">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </md:PackIcon.Style>
                                                    </md:PackIcon>
                                                    <Image Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Source" Value="{Binding AvatarUrl}"/>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                           FontWeight="SemiBold" Foreground="#DDDDEE"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding MemberCountText}" FontSize="10"
                                                           Foreground="#556677">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <md:PackIcon Grid.Column="2" Kind="MessageOutline" Width="14" Height="14"
                                                         Foreground="#3A4060" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <TextBlock x:Name="DmStatusText" Text="" FontSize="12" Foreground="#556677"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </Grid>

                    
                    <Border Grid.Row="2" Background="#11FFFFFF" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="&#x26a1; Envio R&#xe1;pido (Webhook)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#8899AA" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#151B2E" CornerRadius="6" Padding="4" Margin="0,0,6,0">
                                    <ListBox x:Name="QuickMessagesList" Background="Transparent"
                                             BorderThickness="0" MaxHeight="70"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd" CornerRadius="4" Padding="8,4"
                                                                    Background="Transparent" Cursor="Hand">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#335865F2"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11"
                                                           Foreground="#AABBCC" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button x:Name="BtnSendMsg" Click="BtnSendMsg_Click"
                                            Cursor="Hand" BorderThickness="0" Margin="0,0,0,4">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="6" Padding="14,6" Background="#225865F2"
                                                        BorderBrush="#5865F2" BorderThickness="1">
                                                    <TextBlock Text="ENVIAR" FontSize="10" FontWeight="Bold"
                                                               Foreground="#5865F2" HorizontalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock x:Name="MsgStatusText" Text="" FontSize="9"
                                               Foreground="#00E676" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Webhook:" FontSize="9" Foreground="#556677"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="WebhookUrlBox" FontSize="9" Foreground="#8899AA"
                                         Background="#1A2040" BorderBrush="#2A3060" Padding="6,3"
                                         MinWidth="300" TextChanged="WebhookUrlBox_TextChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                
                <Grid x:Name="NotificationsPanel" Visibility="Collapsed">
                    <StackPanel MaxWidth="480" HorizontalAlignment="Center">
                        <TextBlock Text="🔔 Notificações" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#CCDDEE" Margin="0,0,0,12"/>

                        <Border Background="#151B2E" CornerRadius="10" Padding="10" MinHeight="300">
                            <StackPanel>
                                <ItemsControl x:Name="NotificationsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#11FFFFFF" CornerRadius="8"
                                                    Padding="12,8" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="12"
                                                               FontWeight="SemiBold" Foreground="#CCDDEE"/>
                                                    <TextBlock Text="{Binding Body}" FontSize="11"
                                                               Foreground="#8899AA" TextWrapping="Wrap"
                                                               Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding TimeText}" FontSize="9"
                                                               Foreground="#445566" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoNotificationsText"
                                           Text="Nenhuma notificação ainda..."
                                           FontSize="12" Foreground="#556677"
                                           HorizontalAlignment="Center" Margin="0,20,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            
            <Border Grid.Row="3" Padding="16,8" Background="#08FFFFFF">
                <TextBlock x:Name="HintText"
                           FontSize="10" Foreground="#556677" HorizontalAlignment="Center"><Run Text="[LB/RB] Trocar aba  |  [A] Selecionar  |  [B] Fechar  |  [Y] Mut"/><Run Language="pt-br" Text="ar"/><Run Text="  |  [X] Silenciar  |  ⬆⬇ Navegar"/></TextBlock>
            </Border>
        </Grid>
    </Grid>
</Window>