<Window x:Class="GameLauncher.Views.HwRecommendationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="🖥️ Análise de Hardware — Recomendação Gráfica"
        Width="860" Height="560"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#0D0D1A" CornerRadius="10" Padding="24">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="TitleText"
                       Text="🖥️ Análise de Hardware"
                       FontSize="20" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="SubtitleText"
                       Text="Verificando compatibilidade com seu PC..."
                       FontSize="11" Foreground="#556677" Margin="0,3,0,0"/>
        </StackPanel>

        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            
            <Border Grid.Column="0" Background="#0A0A18" CornerRadius="10" Padding="18">
                <StackPanel>
                    <TextBlock Text="🖥️ Seu Hardware" FontSize="14" FontWeight="Bold"
                               Foreground="White" Margin="0,0,0,14"/>

                    
                    <Border Background="#12122A" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <md:PackIcon Kind="Gpu" Width="16" Height="16" Foreground="#8899CC"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="GPU" FontSize="10" Foreground="#8899CC"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="GpuNameText" Text="—"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock x:Name="GpuVramText" Text=""
                                       FontSize="10" Foreground="#778899" Margin="0,2,0,0"/>
                            
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="GpuScoreBar"
                                             Height="6" Minimum="0" Maximum="100" Value="0"
                                             Style="{StaticResource MaterialDesignLinearProgressBar}"
                                             VerticalAlignment="Center"/>
                                <TextBlock x:Name="GpuScoreText" Grid.Column="1"
                                           Text="0/100" FontSize="10" Foreground="#778899"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    
                    <Border Background="#12122A" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <md:PackIcon Kind="Cpu64Bit" Width="16" Height="16" Foreground="#8899CC"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="CPU" FontSize="10" Foreground="#8899CC"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="CpuNameText" Text="—"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock x:Name="CpuDetailText" Text=""
                                       FontSize="10" Foreground="#778899" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    
                    <Border Background="#12122A" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <md:PackIcon Kind="Memory" Width="16" Height="16" Foreground="#8899CC"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="RAM" FontSize="10" Foreground="#8899CC"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="RamText" Text="—"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="UnknownHwText"
                               Text="⚠️ Hardware parcialmente detectado. Instale o app com permissões de administrador para leitura completa."
                               FontSize="10" Foreground="#FFD740" TextWrapping="Wrap"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            
            <Border Grid.Column="2" Background="#0A0A18" CornerRadius="10" Padding="22">
                <Grid>
                    
                    <StackPanel x:Name="LoadingPanel"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                     Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     Width="48" Height="48"
                                     Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Analisando hardware e jogo..."
                                   FontSize="13" Foreground="#556677"
                                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>

                    
                    <StackPanel x:Name="ResultPanel" Visibility="Collapsed">

                        
                        <Border x:Name="PresetBadge" CornerRadius="12" Padding="20,14"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon x:Name="PresetIcon" Kind="Speedometer"
                                             Width="36" Height="36" Foreground="White"
                                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="PresetLabel" Text="ALTO"
                                               FontSize="28" FontWeight="Black"
                                               Foreground="White"/>
                                    <TextBlock x:Name="FpsLabel" Text="~60 fps"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="White" Opacity="0.85"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        
                        <Border Background="#12122A" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                            <TextBlock x:Name="MainMessageText"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="White" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                        </Border>

                        
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="210">
                            <ItemsControl x:Name="DetailsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="12" Foreground="#AABBCC"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        
                        <Border x:Name="UnknownGameBadge"
                                Background="#22FFD740" CornerRadius="6" Padding="10,6"
                                Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="ℹ️ Jogo não está no banco de dados — estimativa genérica"
                                       FontSize="11" Foreground="#FFD740" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterNote"
                       Text="Estimativas baseadas em benchmarks médios a 1080p. Resultados reais podem variar."
                       FontSize="10" Foreground="#334455" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Fechar" Width="100" Height="34"
                    Click="Close_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource AccentBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    Foreground="White"/>
        </Grid>
    </Grid>
    </Border>
</Window>
