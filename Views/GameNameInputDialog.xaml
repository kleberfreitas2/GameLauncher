<Window x:Class="GameLauncher.Views.GameNameInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Nome do Jogo"
        Width="520" Height="280"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#16213E"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Digite o nome correto do jogo para pesquisar nas bases:"
                   Foreground="#AAAAAA" FontSize="13" Margin="0,0,0,6"/>

        <TextBox x:Name="NameTextBox" Grid.Row="1"
                 md:HintAssist.Hint="Nome do jogo"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Foreground="White" CaretBrush="White"
                 FontSize="14" Height="56" VerticalAlignment="Top" VerticalContentAlignment="Center"
                 Margin="0,4,0,0"/>

        <TextBlock Grid.Row="1" VerticalAlignment="Bottom"
                   Foreground="#667788" FontSize="11" FontStyle="Italic"
                   TextWrapping="Wrap" Margin="4,0,0,0"
                   Text="Exemplo: o executável é re9.exe, digite Resident Evil Requiem para pesquisar corretamente nas bases."/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="PULAR" IsCancel="True"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="#888888" Margin="0,0,8,0"
                    Click="Skip_Click"/>
            <Button Content="OK" IsDefault="True"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="#7C4DFF" FontWeight="Bold"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
