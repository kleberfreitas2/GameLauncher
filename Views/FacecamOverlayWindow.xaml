<Window x:Class="GameLauncher.Views.FacecamOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GLauncherFacecam" Width="336" Height="196"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <!-- Outer glow / shadow layer -->
    <Grid Margin="8">
        <!-- Soft ambient glow behind the facecam -->
        <Border CornerRadius="14"
                Background="#1A1A2E">
            <Border.Effect>
                <DropShadowEffect Color="#7C4DFF" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
            </Border.Effect>
        </Border>

        <!-- Main facecam frame with white border -->
        <Border CornerRadius="14"
                BorderBrush="White" BorderThickness="2"
                ClipToBounds="True"
                Background="Black">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.6"/>
            </Border.Effect>

            <!-- Camera feed (mirrored) -->
            <Image x:Name="CameraImage" Stretch="Fill"
                   RenderOptions.BitmapScalingMode="LowQuality"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="-1"/>
                </Image.RenderTransform>
            </Image>
        </Border>
    </Grid>
</Window>
