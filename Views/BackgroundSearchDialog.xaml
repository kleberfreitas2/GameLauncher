<Window x:Class="GameLauncher.Views.BackgroundSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:GameLauncher.Converters"
        Title="&#x1f5bc; Selecionar Imagem de Fundo &#x2014; SteamGridDB"
        Width="860" Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0D0D1A"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}">
    <Window.Resources>
        <converters:UrlToImageSourceConverter x:Key="UrlToImage"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="&#x1f5bc; Selecionar Imagem de Fundo"
                       FontSize="18" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="SubtitleText"
                       FontSize="11" Foreground="#666688" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Image grid -->
        <Border Grid.Row="1" Background="#0A0A18" CornerRadius="8" ClipToBounds="True">
            <Grid>
                <TextBlock x:Name="StatusText"
                           Text="Carregando..."
                           Foreground="#444466" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
                <ProgressBar x:Name="LoadingBar"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Style="{StaticResource MaterialDesignLinearProgressBar}"
                             VerticalAlignment="Top"/>
                <ListBox x:Name="ImageList"
                         Background="Transparent"
                         BorderThickness="0"
                         Visibility="Collapsed"
                         SelectionChanged="ImageList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Margin" Value="4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="3"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderBrush" Value="#1565C0"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#335577"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="240" Height="135" CornerRadius="6" ClipToBounds="True"
                                    Background="#1A1A2E">
                                <Image Source="{Binding ThumbnailUrl, Converter={StaticResource UrlToImage}}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="FooterText" Grid.Column="0"
                       Foreground="#444466" FontSize="11"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1" Content="CANCELAR"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="#888888" Margin="0,0,8,0"
                    Click="Cancel_Click"/>

            <Button x:Name="ApplyButton"
                    Grid.Column="2"
                    Content="APLICAR FUNDO"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#1565C0" BorderBrush="#1565C0"
                    Foreground="White" FontWeight="Bold"
                    IsEnabled="False"
                    Click="Apply_Click"/>
        </Grid>
    </Grid>
</Window>