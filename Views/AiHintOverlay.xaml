<Window x:Class="GameLauncher.Views.AiHintOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="AiHintOverlay"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Border x:Name="RootBorder"
            Background="#E6090915"
            CornerRadius="14"
            Padding="16,12">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.8"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- Ícone animado -->
            <Border Background="{DynamicResource AccentBrush}" CornerRadius="10"
                    Width="38" Height="38" Margin="0,0,12,0">
                <md:PackIcon Kind="Robot" Width="22" Height="22"
                             Foreground="White"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
            </Border>

            <!-- Texto -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="GLauncher AI disponível!"
                           FontSize="13" FontWeight="Bold"
                           Foreground="White"
                           FontFamily="Segoe UI"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="Pressione "
                               FontSize="11" Foreground="#AABBCC"
                               FontFamily="Segoe UI"/>
                    <!-- Badge da hotkey -->
                    <Border Background="#2A2A4A" CornerRadius="5"
                            Padding="6,2" Margin="0,0,4,0">
                        <TextBlock x:Name="HotkeyBadge"
                                   Text="Ctrl+Shift+A"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontFamily="Consolas"/>
                    </Border>
                    <TextBlock Text="para abrir"
                               FontSize="11" Foreground="#AABBCC"
                               FontFamily="Segoe UI"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
