<Window x:Class="GameLauncher.Views.RecordingStartPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RecStart" Width="280" Height="60"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Border x:Name="PopupBorder" Background="#DD1A1A2E" CornerRadius="16" Padding="20,10"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            BorderBrush="#7C4DFF" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="#7C4DFF" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Animated pulsing dot -->
            <Ellipse x:Name="PulseDot" Width="12" Height="12" Fill="#FF1744" Margin="0,0,10,0"
                     VerticalAlignment="Center">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#FF1744" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                </Ellipse.Effect>
            </Ellipse>
            <TextBlock Text="Iniciando gravação..." FontSize="15" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" FontFamily="Segoe UI"/>
        </StackPanel>
    </Border>
</Window>
