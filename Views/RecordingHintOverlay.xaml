<Window x:Class="GameLauncher.Views.RecordingHintOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RecHint" Width="420" Height="90"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Grid Margin="14">
        <Border Background="#E61A1A2E" CornerRadius="14"
                BorderBrush="#7C4DFF" BorderThickness="1.2">
            <Border.Effect>
                <DropShadowEffect Color="#7C4DFF" BlurRadius="24" ShadowDepth="0" Opacity="0.4"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="18,10" Grid.Row="0">
                    <!-- Stylized hotkey key cap -->
                    <Border Background="#252545" CornerRadius="8" Padding="14,7"
                            BorderBrush="#444466" BorderThickness="1"
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#7C4DFF" BlurRadius="6" ShadowDepth="0" Opacity="0.3"/>
                        </Border.Effect>
                        <TextBlock x:Name="HotkeyText" Text="F9" FontSize="17" FontWeight="Bold"
                                   Foreground="#7C4DFF" FontFamily="Consolas"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="Pressione F9 para gravar"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="White" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="SubtitleText" FontSize="11"
                                   Foreground="#7C8BA5" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Ellipse x:Name="HintDot" Width="8" Height="8" Fill="#FF1744"
                             Margin="16,0,4,0" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#FF1744" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </StackPanel>

                <!-- Countdown progress bar -->
                <Border Grid.Row="1" Height="3" CornerRadius="0,0,13,13"
                        Background="#151530" ClipToBounds="True" Margin="1,0,1,1">
                    <Rectangle x:Name="TimerBar" Fill="#7C4DFF" Opacity="0.7"
                               HorizontalAlignment="Stretch"
                               RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="TimerBarScale" ScaleX="1"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
