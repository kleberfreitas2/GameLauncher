<Window x:Class="GameLauncher.Views.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="📖 Manual do GLauncher"
        Width="820" Height="620"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#0F1527"
        TextElement.Foreground="White"
        TextElement.FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Navigation sidebar -->
        <Border Background="#0A0E1A" BorderBrush="#1A2040" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="📖" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Manual" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="GLauncher v1.0" FontSize="11" Foreground="#556688"/>
                </StackPanel>

                <!-- Nav items -->
                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="NavList_SelectionChanged"
                         SelectedIndex="0"
                         Padding="8,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="#8899BB"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="NavBd" Background="Transparent" CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NavBd" Property="Background" Value="#15192E"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="NavBd" Property="Background" Value="#1A2548"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Content="🏠  Início"/>
                    <ListBoxItem Content="➕  Adicionar Jogos"/>
                    <ListBoxItem Content="🎮  Biblioteca e Carrossel"/>
                    <ListBoxItem Content="⚙️  Menu de Opções"/>
                    <ListBoxItem Content="🖼️  Capas e Fundos"/>
                    <ListBoxItem Content="📊  Info IGDB"/>
                    <ListBoxItem Content="🎨  Temas"/>
                    <ListBoxItem Content="🕹️  Controle (Gamepad)"/>
                    <ListBoxItem Content="📈  Monitor de Hardware"/>
                    <ListBoxItem Content="⌨️  Atalhos"/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right: Content area -->
        <Border Grid.Column="1" Padding="28,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <!-- Page 0: Início -->
                        <StackPanel x:Name="Page0">
                            <TextBlock Text="Bem-vindo ao GLauncher!" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                            <TextBlock Text="Seu launcher de jogos estilo PS5" FontSize="14" Foreground="#00E676" Margin="0,0,0,20"/>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="O que é o GLauncher?" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        O GLauncher é um launcher de jogos para PC com interface inspirada no PlayStation 5.
                                        Ele organiza sua biblioteca, busca automaticamente capas, logos, fundos animados
                                        e informações dos seus jogos, além de monitorar hardware em tempo real.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="✨ Principais Recursos" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="• Interface estilo PS5 com carrossel horizontal" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="• Fundos animados (WEBP/GIF) para cada jogo" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="• Busca automática de capas, logos e fundos (SteamGridDB)" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="• Informações do IGDB (sinopse, gênero, nota, ano)" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="• Tradução automática para Português" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="• Suporte a controle Xbox/XInput" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="• Monitor de CPU, GPU, RAM e temperaturas" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="• Sistema de favoritos com estrela ⭐" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="• Múltiplos temas visuais" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="• Avatar personalizável" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Page 1: Adicionar Jogos -->
                        <StackPanel x:Name="Page1" Visibility="Collapsed">
                            <TextBlock Text="➕ Adicionar Jogos" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Como adicionar jogos" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        1. Clique no botão "+ ADICIONAR JOGO" no cabeçalho superior
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        2. Selecione o arquivo .exe do jogo (é possível selecionar vários de uma vez)
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        3. Para cada executável, uma caixa de diálogo será exibida para você digitar o nome correto do jogo
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#88AACC" LineHeight="22" Margin="20,4,0,0" FontStyle="Italic">
                                        Exemplo: o executável é re9.exe, você digita "Resident Evil Requiem" para pesquisar corretamente nas bases.
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        4. Ao clicar em OK, um indicador de progresso (0 a 100%) será exibido enquanto o GLauncher busca automaticamente:
                                    </TextBlock>
                                    <StackPanel Margin="20,6,0,0">
                                        <TextBlock Text="• Ícone do jogo no SteamGridDB" FontSize="13" Foreground="#88AACC" Margin="0,2"/>
                                        <TextBlock Text="• Logo do jogo" FontSize="13" Foreground="#88AACC" Margin="0,2"/>
                                        <TextBlock Text="• Capa (grid) para o carrossel" FontSize="13" Foreground="#88AACC" Margin="0,2"/>
                                        <TextBlock Text="• Fundo (hero) animado ou estático" FontSize="13" Foreground="#88AACC" Margin="0,2"/>
                                        <TextBlock Text="• Sinopse, gênero, nota e ano no IGDB" FontSize="13" Foreground="#88AACC" Margin="0,2"/>
                                        <TextBlock Text="• Tradução automática da descrição para Português" FontSize="13" Foreground="#88AACC" Margin="0,2"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        5. Ao finalizar, todas as informações são carregadas automaticamente na tela
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#1A1230" CornerRadius="10" Padding="20,14" Margin="0,0,0,14"
                                    BorderBrush="#2A2050" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock Text="💡" FontSize="16" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,10,0"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#BBAADD" LineHeight="20">
                                        Dica: Se clicar em "PULAR" na caixa de nome, o GLauncher usará o nome do executável 
                                        (que pode não ser encontrado nas bases). Para melhores resultados, sempre digite o nome real do jogo.
                                    </TextBlock>
                                </DockPanel>
                            </Border>

                            </StackPanel>

                        <!-- Page 2: Biblioteca e Carrossel -->
                        <StackPanel x:Name="Page2" Visibility="Collapsed">
                            <TextBlock Text="🎮 Biblioteca e Carrossel" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Carrossel de Jogos" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        A biblioteca exibe seus jogos em um carrossel horizontal estilo PS5.
                                        Clique em um jogo para selecioná-lo e ver seus detalhes.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Painel de Detalhes" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        Ao selecionar um jogo, o painel inferior exibe:
                                    </TextBlock>
                                    <StackPanel Margin="12,8,0,0">
                                        <TextBlock Text="• Fundo animado (WEBP/GIF) ou estático" FontSize="13" Foreground="#88AACC" Margin="0,2"/>
                                        <TextBlock Text="• Logo ou nome do jogo" FontSize="13" Foreground="#88AACC" Margin="0,2"/>
                                        <TextBlock Text="• Botão JOGAR para iniciar" FontSize="13" Foreground="#88AACC" Margin="0,2"/>
                                        <TextBlock Text="• Detalhes: atividade recente, tamanho, gênero, nota, ano" FontSize="13" Foreground="#88AACC" Margin="0,2"/>
                                        <TextBlock Text="• Descrição traduzida para Português" FontSize="13" Foreground="#88AACC" Margin="0,2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="⭐ Favoritos" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        Jogos favoritos aparecem primeiro no carrossel e exibem uma estrela dourada ⭐ 
                                        no canto superior direito da capa.
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Page 3: Menu de Opções -->
                        <StackPanel x:Name="Page3" Visibility="Collapsed">
                            <TextBlock Text="⚙️ Menu de Opções" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Como acessar" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        Clique no ícone de engrenagem ⚙️ no cabeçalho para abrir o menu de contexto
                                        com as opções do jogo selecionado.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Opções disponíveis" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Alternar Favorito" FontSize="13" Foreground="#FFD700" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="Marca/desmarca o jogo como favorito ⭐" FontSize="12" Foreground="#8899AA" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Alterar Imagem" FontSize="13" Foreground="#5599CC" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="Escolhe manualmente uma imagem local para a capa" FontSize="12" Foreground="#8899AA" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Buscar Capa Online" FontSize="13" Foreground="#5599CC" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="Busca capas (grids) no SteamGridDB com seleção visual" FontSize="12" Foreground="#8899AA" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Buscar Fundo" FontSize="13" Foreground="#5599CC" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="Busca fundos animados (heroes) no SteamGridDB com preview" FontSize="12" Foreground="#8899AA" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Buscar Info IGDB" FontSize="13" Foreground="#5599CC" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="Busca sinopse, gênero, nota e ano no IGDB" FontSize="12" Foreground="#8899AA" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Renomear" FontSize="13" Foreground="#5599CC" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="Altera o nome de exibição do jogo" FontSize="12" Foreground="#8899AA" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Remover Jogo" FontSize="13" Foreground="#FF5555" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="Remove o jogo da biblioteca (não desinstala)" FontSize="12" Foreground="#8899AA" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Page 4: Capas e Fundos -->
                        <StackPanel x:Name="Page4" Visibility="Collapsed">
                            <TextBlock Text="🖼️ Capas e Fundos" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="SteamGridDB" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        O GLauncher utiliza o SteamGridDB para buscar automaticamente:
                                    </TextBlock>
                                    <StackPanel Margin="12,8,0,0">
                                        <TextBlock Text="• Capas (Grids) — exibidas no carrossel" FontSize="13" Foreground="#88AACC" Margin="0,3"/>
                                        <TextBlock Text="• Logos — exibidos sobre o fundo do jogo" FontSize="13" Foreground="#88AACC" Margin="0,3"/>
                                        <TextBlock Text="• Fundos (Heroes) — imagem de fundo, suporta WEBP/GIF animado" FontSize="13" Foreground="#88AACC" Margin="0,3"/>
                                        <TextBlock Text="• Ícones — exibidos junto ao nome" FontSize="13" Foreground="#88AACC" Margin="0,3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Busca Manual de Capas" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        No menu ⚙️ → "Buscar Capa Online", você pode pesquisar e escolher 
                                        visualmente entre diversas capas disponíveis para o jogo.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Busca Manual de Fundos" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        No menu ⚙️ → "Buscar Fundo", você visualiza previews animados dos fundos
                                        disponíveis e seleciona o que preferir. Suporta WEBP animado e GIF.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#1A1230" CornerRadius="10" Padding="20,14"
                                    BorderBrush="#2A2050" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock Text="✅" FontSize="16" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,10,0"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#BBAADD" LineHeight="20">
                                        A integração com o SteamGridDB é automática. As capas, logos, fundos e ícones 
                                        são buscados automaticamente ao adicionar um jogo.
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- Page 5: Info IGDB -->
                        <StackPanel x:Name="Page5" Visibility="Collapsed">
                            <TextBlock Text="📊 Informações IGDB" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="O que é o IGDB?" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        O IGDB (Internet Game Database) é uma base de dados de jogos da Twitch/Amazon.
                                        O GLauncher busca automaticamente:
                                    </TextBlock>
                                    <StackPanel Margin="12,8,0,0">
                                        <TextBlock Text="• Sinopse / Descrição do jogo" FontSize="13" Foreground="#88AACC" Margin="0,3"/>
                                        <TextBlock Text="• Gêneros (traduzidos para PT-BR)" FontSize="13" Foreground="#88AACC" Margin="0,3"/>
                                        <TextBlock Text="• Nota / Rating da comunidade" FontSize="13" Foreground="#FFD700" Margin="0,3"/>
                                        <TextBlock Text="• Ano de lançamento" FontSize="13" Foreground="#88AACC" Margin="0,3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#1A1230" CornerRadius="10" Padding="20,14"
                                    BorderBrush="#2A2050" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock Text="✅" FontSize="16" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,10,0"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#BBAADD" LineHeight="20">
                                        A integração com o IGDB é automática. Sinopse, gêneros, nota e ano 
                                        são buscados e traduzidos automaticamente ao adicionar um jogo.
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- Page 6: Temas -->
                        <StackPanel x:Name="Page6" Visibility="Collapsed">
                            <TextBlock Text="🎨 Temas" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Personalização Visual" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        Clique no botão "TEMA" no cabeçalho para abrir o seletor de temas.
                                        O tema é aplicado imediatamente e salvo automaticamente.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Avatar" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        Clique no avatar (canto superior direito) para escolher uma imagem personalizada.
                                        Suporta PNG, JPG, BMP e WEBP.
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Page 7: Controle (Gamepad) -->
                        <StackPanel x:Name="Page7" Visibility="Collapsed">
                            <TextBlock Text="🕹️ Controle (Gamepad)" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Suporte a XInput" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        O GLauncher detecta automaticamente controles Xbox e compatíveis com XInput.
                                        O ícone do controle no cabeçalho fica verde quando conectado.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Mapeamento de Botões" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="13" Foreground="#00E676" FontWeight="SemiBold">
                                            <Run Text="D-Pad"/>
                                            <Run Text=" ◀ ▶" Foreground="#556688"/>
                                        </TextBlock>
