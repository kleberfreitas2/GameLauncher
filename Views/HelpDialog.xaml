<Window x:Class="GameLauncher.Views.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="&#x1f4d6; Manual do GLauncher"
        Width="820" Height="720"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#0F1527"
        TextElement.Foreground="White"
        TextElement.FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

<Border Background="#0A0E1A" BorderBrush="#1A2040" BorderThickness="0,0,1,0">
            <DockPanel>
<StackPanel DockPanel.Dock="Top" Margin="16,20,16,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="&#x1f4d6;" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Manual" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="GLauncher v2.5" FontSize="11" Foreground="#556688"/>
                </StackPanel>

<ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="NavList_SelectionChanged"
                         SelectedIndex="0"
                         Padding="8,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="#8899BB"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="NavBd" Background="Transparent" CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NavBd" Property="Background" Value="#15192E"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="NavBd" Property="Background" Value="#1A2548"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Content="&#x1f3e0;  In&#xed;cio"/>
                    <ListBoxItem Content="&#x2795;  Adicionar Jogos"/>
                    <ListBoxItem Content="&#x1f3ae;  Steam"/>
                    <ListBoxItem Content="&#x1f3ae;  Xbox Live"/>
                    <ListBoxItem Content="&#x1f4ac;  Discord"/>
                    <ListBoxItem Content="&#x1f3ae;  Epic Games"/>
                    <ListBoxItem Content="&#x1f3ae;  Biblioteca e Carrossel"/>
                    <ListBoxItem Content="&#x2699;&#xfe0f;  Menu de Op&#xe7;&#xf5;es"/>
                    <ListBoxItem Content="&#x1f5bc;&#xfe0f;  Capas e Fundos"/>
                    <ListBoxItem Content="&#x1f4ca;  Info IGDB"/>
                    <ListBoxItem Content="&#x1f3a8;  Temas"/>
                    <ListBoxItem Content="&#x1f579;&#xfe0f;  Controle (Gamepad)"/>
                    <ListBoxItem Content="&#x1f4c8;  Monitor de Hardware"/>
                    <ListBoxItem Content="&#x2328;&#xfe0f;  Atalhos"/>
                </ListBox>
            </DockPanel>
        </Border>

<Border Grid.Column="1" Padding="28,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
<StackPanel x:Name="Page0">
                            <TextBlock Text="Bem-vindo ao GLauncher!" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                            <TextBlock FontSize="14" Foreground="#00E676" Margin="0,0,0,20"><Run Text="Seu launcher de jogos estilo "/><Run Language="pt-br" Text="console"/></TextBlock>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="O que &#xe9; o GLauncher?" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        O GLauncher &#xe9; um launcher de jogos para PC com interface inspirada no PlayStation 5.
                                        Ele organiza sua biblioteca, busca automaticamente capas, logos, fundos animados
                                        e informa&#xe7;&#xf5;es dos seus jogos, al&#xe9;m de monitorar hardware em tempo real.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="&#x2728; Principais Recursos" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="&#x2022; Interface estilo PS5 com carrossel horizontal" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Integra&#xe7;&#xe3;o com Steam &#x2014; detecta sua conta automaticamente e importa jogos" FontSize="13" Foreground="#66C0F4" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Integra&#xe7;&#xe3;o com Xbox Live &#x2014; login com conta Microsoft e importa&#xe7;&#xe3;o de jogos" FontSize="13" Foreground="#107C10" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Fundos animados (WEBP/GIF) para cada jogo" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Busca autom&#xe1;tica de capas, logos e fundos (SteamGridDB)" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Informa&#xe7;&#xf5;es do IGDB (sinopse, g&#xea;nero, nota, ano)" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Tradu&#xe7;&#xe3;o autom&#xe1;tica para Portugu&#xea;s" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Contador de FPS em tempo real" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Suporte a controle Xbox e PlayStation (DualSense/DualShock)" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Navega&#xe7;&#xe3;o completa por zonas com gamepad (Header / A&#xe7;&#xf5;es / Carrossel)" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; N&#xed;vel de bateria do controle em tempo real &#x1f50b;" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Efeitos sonoros estilo console (navegar, selecionar, favoritar, erro)" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Minimiza o launcher ao jogar e restaura ao sair do jogo" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Monitor de CPU, GPU, RAM e temperaturas" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Sistema de favoritos com estrela &#x2b50;" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; M&#xfa;ltiplos temas visuais" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Avatar personaliz&#xe1;vel" FontSize="13" Foreground="#AABBCC" Margin="0,3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

<StackPanel x:Name="Page1" Visibility="Collapsed">
                            <TextBlock Text="&#x2795; Adicionar Jogos" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Adicionar manualmente" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        1. Clique no bot&#xe3;o &#x201c;+ ADICIONAR JOGO&#x201d; no cabe&#xe7;alho superior
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        2. Selecione o arquivo .exe do jogo (&#xe9; poss&#xed;vel selecionar v&#xe1;rios de uma vez)
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        3. Para cada execut&#xe1;vel, uma caixa de di&#xe1;logo ser&#xe1; exibida para voc&#xea; digitar o nome correto do jogo
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#88AACC" LineHeight="22" Margin="20,4,0,0" FontStyle="Italic">
                                        Exemplo: o execut&#xe1;vel &#xe9; re9.exe, voc&#xea; digita &#x201c;Resident Evil Requiem&#x201d; para pesquisar corretamente nas bases.
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        4. Ao clicar em OK, um indicador de progresso (0 a 100%) ser&#xe1; exibido enquanto o GLauncher busca automaticamente:
                                    </TextBlock>
                                    <StackPanel Margin="20,6,0,0">
                                        <TextBlock Text="&#x2022; &#xcd;cone do jogo no SteamGridDB" FontSize="13" Foreground="#88AACC" Margin="0,2"/>
                                        <TextBlock Text="&#x2022; Logo do jogo" FontSize="13" Foreground="#88AACC" Margin="0,2"/>
                                        <TextBlock Text="&#x2022; Capa (grid) para o carrossel" FontSize="13" Foreground="#88AACC" Margin="0,2"/>
                                        <TextBlock Text="&#x2022; Fundo (hero) animado ou est&#xe1;tico" FontSize="13" Foreground="#88AACC" Margin="0,2"/>
                                        <TextBlock Text="&#x2022; Sinopse, g&#xea;nero, nota e ano no IGDB" FontSize="13" Foreground="#88AACC" Margin="0,2"/>
                                        <TextBlock Text="&#x2022; Tradu&#xe7;&#xe3;o autom&#xe1;tica da descri&#xe7;&#xe3;o para Portugu&#xea;s" FontSize="13" Foreground="#88AACC" Margin="0,2"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        5. Ao finalizar, todas as informa&#xe7;&#xf5;es s&#xe3;o carregadas automaticamente na tela
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Importar da Steam ou Xbox" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        Voc&#xea; tamb&#xe9;m pode importar jogos instalados automaticamente atrav&#xe9;s das integra&#xe7;&#xf5;es:
                                    </TextBlock>
                                    <StackPanel Margin="12,8,0,0">
                                        <TextBlock FontSize="13" Foreground="#66C0F4" Margin="0,3" TextWrapping="Wrap"><Run Text="&#x2022; Steam" FontWeight="SemiBold"/> <Run Text="&#x2014; Clique no bot&#xe3;o STEAM no cabe&#xe7;alho. Detecta sua conta automaticamente e importa os jogos instalados." Foreground="#AABBCC"/></TextBlock>
                                        <TextBlock FontSize="13" Foreground="#107C10" Margin="0,3" TextWrapping="Wrap"><Run Text="&#x2022; Xbox" FontWeight="SemiBold"/> <Run Text="&#x2014; Clique no bot&#xe3;o XBOX no cabe&#xe7;alho. Fa&#xe7;a login com sua conta Microsoft e importe os jogos instalados." Foreground="#AABBCC"/></TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#1A1230" CornerRadius="10" Padding="20,14" Margin="0,0,0,14"
                                    BorderBrush="#2A2050" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock Text="&#x1f4a1;" FontSize="16" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,10,0"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#BBAADD" LineHeight="20">
                                        Dica: Se clicar em &#x201c;PULAR&#x201d; na caixa de nome, o GLauncher usar&#xe1; o nome do execut&#xe1;vel 
                                        (que pode n&#xe3;o ser encontrado nas bases). Para melhores resultados, sempre digite o nome real do jogo.
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </StackPanel>

<StackPanel x:Name="Page2" Visibility="Collapsed">
                            <TextBlock Text="&#x1f3ae; Integra&#xe7;&#xe3;o Steam" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Como funciona" FontSize="15" FontWeight="SemiBold" Foreground="#66C0F4" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        A integra&#xe7;&#xe3;o com a Steam &#xe9; totalmente autom&#xe1;tica. N&#xe3;o &#xe9; necess&#xe1;rio configurar API Key, 
                                        Steam ID ou qualquer outro dado. Basta ter o Steam instalado e estar logado.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Passo a passo" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        1. Clique no bot&#xe3;o <Run FontWeight="SemiBold" Foreground="#66C0F4">STEAM</Run> no cabe&#xe7;alho
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        2. O GLauncher detecta automaticamente sua conta Steam logada no PC
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        3. Seu perfil &#xe9; carregado com nome, avatar e n&#xfa;mero de jogos instalados
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        4. Na tela de perfil, clique em <Run FontWeight="SemiBold" Foreground="#66C0F4">IMPORTAR JOGOS STEAM</Run>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        5. Todos os jogos instalados s&#xe3;o detectados e adicionados &#xe0; biblioteca
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        6. Capas, logos, fundos e informa&#xe7;&#xf5;es s&#xe3;o buscadas automaticamente para cada jogo importado
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Perfil Steam" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        Ap&#xf3;s conectar, o bot&#xe3;o Steam no cabe&#xe7;alho exibe seu nome e a quantidade de jogos.
                                        Clicando nele, voc&#xea; abre o perfil com:
                                    </TextBlock>
                                    <StackPanel Margin="12,8,0,0">
                                        <TextBlock Text="&#x2022; Avatar e nome do perfil Steam" FontSize="13" Foreground="#88AACC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Total de jogos instalados" FontSize="13" Foreground="#88AACC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Quantidade j&#xe1; importada e dispon&#xed;vel" FontSize="13" Foreground="#88AACC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Bot&#xe3;o para importar jogos" FontSize="13" Foreground="#88AACC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Bot&#xe3;o para desconectar" FontSize="13" Foreground="#88AACC" Margin="0,3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#1A1230" CornerRadius="10" Padding="20,14"
                                    BorderBrush="#2A2050" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock Text="&#x2705;" FontSize="16" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,10,0"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#BBAADD" LineHeight="20">
                                        A conex&#xe3;o &#xe9; restaurada automaticamente ao abrir o GLauncher. Se o Steam estiver 
                                        rodando e logado, voc&#xea; j&#xe1; ver&#xe1; seu perfil no cabe&#xe7;alho sem precisar clicar em nada.
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </StackPanel>

<StackPanel x:Name="Page3" Visibility="Collapsed">
                            <TextBlock Text="&#x1f3ae; Integra&#xe7;&#xe3;o Xbox Live" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Como funciona" FontSize="15" FontWeight="SemiBold" Foreground="#107C10" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        A integra&#xe7;&#xe3;o com o Xbox Live permite que voc&#xea; fa&#xe7;a login com sua conta Microsoft
                                        e importe os jogos Xbox/Game Pass instalados no seu PC.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Passo a passo" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        1. Clique no bot&#xe3;o <Run FontWeight="SemiBold" Foreground="#00E676">XBOX</Run> no cabe&#xe7;alho
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        2. Uma janela de login da Microsoft ser&#xe1; aberta no navegador
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        3. Fa&#xe7;a login com sua conta Microsoft/Xbox
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        4. Seu perfil Xbox &#xe9; carregado com Gamertag, Gamerscore e avatar
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        5. Na tela de perfil, clique em <Run FontWeight="SemiBold" Foreground="#00E676">IMPORTAR JOGOS XBOX</Run>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        6. Os jogos Xbox/Game Pass instalados no PC s&#xe3;o adicionados &#xe0; biblioteca
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
                                        7. Capas, logos, fundos e informa&#xe7;&#xf5;es s&#xe3;o buscadas automaticamente
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Perfil Xbox" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        Ap&#xf3;s conectar, o bot&#xe3;o Xbox no cabe&#xe7;alho exibe sua Gamertag e Gamerscore.
                                        Clicando nele, voc&#xea; abre o perfil com:
                                    </TextBlock>
                                    <StackPanel Margin="12,8,0,0">
                                        <TextBlock Text="&#x2022; Avatar e Gamertag" FontSize="13" Foreground="#88AACC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Gamerscore total" FontSize="13" Foreground="#FFD700" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Jogos na biblioteca Xbox e importados" FontSize="13" Foreground="#88AACC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Bot&#xe3;o para importar jogos" FontSize="13" Foreground="#88AACC" Margin="0,3"/>
                                        <TextBlock Text="&#x2022; Bot&#xe3;o para desconectar" FontSize="13" Foreground="#88AACC" Margin="0,3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#1A1230" CornerRadius="10" Padding="20,14"
                                    BorderBrush="#2A2050" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock Text="&#x2705;" FontSize="16" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,10,0"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#BBAADD" LineHeight="20">
                                        O login do Xbox &#xe9; restaurado automaticamente ao reabrir o GLauncher 
                                        (n&#xe3;o precisa fazer login toda vez).
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </StackPanel>

<StackPanel x:Name="Page4" Visibility="Collapsed">
                            <TextBlock Text="&#x1f4ac; Integra&#xe7;&#xe3;o Discord" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Login e Perfil" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        A integra&#xe7;&#xe3;o com o Discord permite fazer login com sua conta Discord
                                        via OAuth2. Ap&#xf3;s autorizar, o GLauncher exibe seu nome e avatar
                                        do Discord no cabe&#xe7;alho.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#151B30" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Como conectar" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22">
                                        <Run FontWeight="SemiBold" Foreground="#5865F2">1.</Run> Clique no bot&#xe3;o <Run FontWeight="SemiBold" Foreground="#5865F2">DISCORD</Run> (roxo) no cabe&#xe7;alho
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#AABBCC" LineHeight="22" Margin="0,4,0,0">
