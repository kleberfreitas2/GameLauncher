<Window x:Class="GameLauncher.Views.IgdbGameInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="🌐 Informações do Jogo — IGDB"
        Width="940" Height="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0D0D1A"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

<StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🌐 Buscar Informações — IGDB"
                       FontSize="18" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Busque metadados: descrição, rating, gênero e ano de lançamento"
                       FontSize="11" Foreground="#666688" Margin="0,3,0,0"/>
        </StackPanel>

<Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

<Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

<Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="Nome do jogo..."
                             Foreground="White" CaretBrush="White"
                             Background="#16213E"
                             Margin="0,0,8,0"
                             KeyDown="SearchBox_KeyDown"/>
                    <Button Grid.Column="1"
                            Width="42" Height="42" Padding="0"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{DynamicResource AccentBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            Click="Search_Click">
                        <md:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="White"/>
                    </Button>
                </Grid>

<Border Grid.Row="1" Background="#0A0A18" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <TextBlock x:Name="StatusText"
                                   Text="Digite o nome do jogo e clique em 🔍"
                                   Foreground="#444466" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="16,0"/>
                        <ProgressBar x:Name="LoadingBar"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed"
                                     Style="{StaticResource MaterialDesignLinearProgressBar}"
                                     VerticalAlignment="Top"
                                     Margin="0"/>
                        <ListView x:Name="ResultsList"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Visibility="Collapsed"
                                  SelectionChanged="ResultsList_SelectionChanged">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1E1E4A"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#14142E"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="White"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding YearText}"
                                                   FontSize="10" Foreground="#6666AA"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

<Border Grid.Column="1" Background="#0A0A18" CornerRadius="8" Padding="20" ClipToBounds="True">
                <Grid>
<StackPanel x:Name="EmptyDetail"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <md:PackIcon Kind="InformationOutline" Width="48" Height="48"
                                     Foreground="#222244" HorizontalAlignment="Center"/>
                        <TextBlock Text="Selecione um resultado para ver os detalhes"
                                   Foreground="#444466" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>

<Grid x:Name="DetailPanel" Visibility="Collapsed">
<StackPanel Margin="0">
<TextBlock x:Name="GameTitle"
                                       FontSize="16" FontWeight="Bold" Foreground="White"
                                       TextWrapping="Wrap" Margin="0,0,0,14"/>

<StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <md:PackIcon Kind="Star" Width="14" Height="14"
                                             Foreground="#FFD700" VerticalAlignment="Center"
                                             Margin="0,0,6,0"/>
                                <TextBlock Text="Rating: " FontSize="11"
                                           Foreground="#9999BB" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RatingText" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FFD700" VerticalAlignment="Center"/>
                            </StackPanel>

<StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <md:PackIcon Kind="Calendar" Width="14" Height="14"
                                             Foreground="#66AAFF" VerticalAlignment="Center"
                                             Margin="0,0,6,0"/>
                                <TextBlock Text="Lançamento: " FontSize="11"
                                           Foreground="#9999BB" VerticalAlignment="Center"/>
                                <TextBlock x:Name="YearText" FontSize="11"
                                           Foreground="#66AAFF" VerticalAlignment="Center"/>
                            </StackPanel>

<StackPanel Orientation="Horizontal" Margin="0,0,0,14" >
                                <md:PackIcon Kind="TagOutline" Width="14" Height="14"
                                             Foreground="#AA88FF" VerticalAlignment="Center"
                                             Margin="0,0,6,0"/>
                                <TextBlock Text="Gêneros: " FontSize="11"
                                           Foreground="#9999BB" VerticalAlignment="Center"/>
                                <TextBlock x:Name="GenreText" FontSize="11"
                                           Foreground="#AA88FF" TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

<TextBlock Text="DESCRIÇÃO"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#444466" Margin="0,0,0,6"/>
                            <ScrollViewer Height="165" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="SummaryText"
                                           FontSize="11" Foreground="#AAAACC"
                                           TextWrapping="Wrap" LineHeight="18"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

<Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="FooterText" Grid.Column="0"
                       Foreground="#444466" FontSize="11"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1" Content="CANCELAR"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="#888888" Margin="0,0,8,0"
                    Click="Cancel_Click"/>

            <Button x:Name="ApplyInfoButton"
                    Grid.Column="2"
                    Content="APLICAR INFORMAÇÕES"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource AccentGreenBrush}"
                    BorderBrush="{DynamicResource AccentGreenBrush}"
                    Foreground="#0D0D0D" FontWeight="Bold"
                    IsEnabled="False"
                    Click="ApplyInfo_Click"/>
        </Grid>
    </Grid>
</Window>

