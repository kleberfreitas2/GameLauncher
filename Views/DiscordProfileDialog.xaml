<Window x:Class="GameLauncher.Views.DiscordProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="&#x1f3ae; Perfil Discord"
        Width="420" Height="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0D0D0D"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid>
        <Border VerticalAlignment="Top" Height="110">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#5865F2" Offset="0"/>
                    <GradientStop Color="#0D0D0D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel HorizontalAlignment="Center" Margin="0,30,0,0">
            <Grid Width="96" Height="96" HorizontalAlignment="Center">
                <Ellipse Width="96" Height="96" Fill="#23272A" Stroke="#5865F2" StrokeThickness="3">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#5865F2" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                    </Ellipse.Effect>
                </Ellipse>
                <md:PackIcon Kind="MessageText" Width="48" Height="48" Foreground="#334455"
                             HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="FallbackIcon"/>
                <Ellipse x:Name="AvatarEllipse" Width="90" Height="90"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="DisplayNameText" Text="&#x2014;" FontSize="22" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,14,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.7"/>
                </TextBlock.Effect>
            </TextBlock>

            <Border CornerRadius="12" Padding="14,4"
                    HorizontalAlignment="Center" Margin="0,6,0,0" Background="#225865F2">
                <TextBlock x:Name="UsernameText" Text="Discord" FontSize="11"
                           FontWeight="SemiBold" Foreground="#5865F2"/>
            </Border>

            <TextBlock x:Name="IdText" Text="" FontSize="10" Foreground="#556677"
                       HorizontalAlignment="Center" Margin="0,16,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="DESCONECTAR" Click="Logout_Click"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#FF5252" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
