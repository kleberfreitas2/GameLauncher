<Window x:Class="GameLauncher.Views.RecordingSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="&#x1f3ae; Gravação de Vídeo"
        Width="460" Height="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0D0D0D"
        TextElement.Foreground="White"
        TextElement.FontFamily="Segoe UI">
    <Grid>
        <Border VerticalAlignment="Top" Height="80">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B71C1C" Offset="0"/>
                    <GradientStop Color="#0D0D0D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0">
        <StackPanel HorizontalAlignment="Center" Margin="0,24,0,20">
            <!-- Icon -->
            <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                <Ellipse Width="56" Height="56" Fill="#33FF1744">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#FF1744" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                    </Ellipse.Effect>
                </Ellipse>
                <md:PackIcon Kind="VideoOutline" Width="28" Height="28" Foreground="#FF1744"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Title -->
            <TextBlock Text="GRAVAÇÃO DE VÍDEO" FontSize="18" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,4,0,2"/>
            <TextBlock Text="Configure a gravação dos seus jogos" FontSize="11" Foreground="#778899"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Enable toggle -->
            <Border Background="#161622" CornerRadius="12" Padding="16,12" HorizontalAlignment="Center"
                    MinWidth="380" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Gravação ativada" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Pressione F9 durante o jogo para gravar" FontSize="10" Foreground="#667788" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="EnableToggle" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  Checked="EnableToggle_Changed" Unchecked="EnableToggle_Changed"/>
                </Grid>
            </Border>

            <!-- Hotkey display -->
            <Border Background="#161622" CornerRadius="12" Padding="16,12" HorizontalAlignment="Center"
                    MinWidth="380" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Tecla de atalho" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Pressione durante o jogo para iniciar/parar" FontSize="10" Foreground="#667788" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#22FF1744" CornerRadius="8" Padding="14,6"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="HotkeyText" Text="F9" FontSize="14" FontWeight="Bold"
                                   Foreground="#FF1744" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Resolution selector -->
            <Border Background="#161622" CornerRadius="12" Padding="16,12" HorizontalAlignment="Center"
                    MinWidth="380" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Resolução de gravação" FontSize="13" FontWeight="SemiBold" Foreground="White"
                               Margin="0,0,0,10"/>

                    <RadioButton x:Name="Rb720" GroupName="Resolution" Foreground="White" FontSize="12"
                                 Margin="0,0,0,8" Checked="Resolution_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="720p" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="  (1280×720) — 60 FPS" Foreground="#778899" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="Rb1080" GroupName="Resolution" Foreground="White" FontSize="12"
                                 Margin="0,0,0,8" Checked="Resolution_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="1080p" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="  (1920×1080) — 60 FPS" Foreground="#778899" VerticalAlignment="Center"/>
                            <Border Background="#2200E676" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Recomendado" FontSize="9" Foreground="#00E676" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="Rb4K" GroupName="Resolution" Foreground="White" FontSize="12"
                                 Checked="Resolution_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="4K" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="  (3840×2160) — 60 FPS" Foreground="#778899" VerticalAlignment="Center"/>
                            <Border Background="#22FFD740" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Pesado" FontSize="9" Foreground="#FFD740" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Output folder -->
            <Border Background="#161622" CornerRadius="12" Padding="16,10" HorizontalAlignment="Center"
                    MinWidth="380" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Pasta de saída" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="OutputPathText" Text="" FontSize="9" Foreground="#556677" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="ABRIR" Click="OpenFolder_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#4FC3F7" FontWeight="Bold" FontSize="11" Padding="10,4"/>
                </Grid>
            </Border>

            <!-- FFmpeg status -->
            <Border x:Name="FfmpegStatusBorder" Background="#161622" CornerRadius="12" Padding="16,10"
                    HorizontalAlignment="Center" MinWidth="380">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <md:PackIcon x:Name="FfmpegIcon" Kind="CheckCircle" Width="18" Height="18"
                                 Foreground="#00E676" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="FfmpegStatusText" Text="FFmpeg pronto" FontSize="12"
                               Foreground="#00E676" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
