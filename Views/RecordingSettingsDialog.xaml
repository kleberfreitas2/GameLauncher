<Window x:Class="GameLauncher.Views.RecordingSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="&#x1f3ae; Grava&#xe7;&#xe3;o de V&#xed;deo"
        Width="480" Height="780"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0D0D0D"
        TextElement.Foreground="White"
        TextElement.FontFamily="Segoe UI">
    <Grid>
        <Border VerticalAlignment="Top" Height="80">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B71C1C" Offset="0"/>
                    <GradientStop Color="#0D0D0D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0">
        <StackPanel HorizontalAlignment="Center" Margin="0,24,0,20">
            <!-- Icon -->
            <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                <Ellipse Width="56" Height="56" Fill="#33FF1744">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#FF1744" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                    </Ellipse.Effect>
                </Ellipse>
                <md:PackIcon Kind="VideoOutline" Width="28" Height="28" Foreground="#FF1744"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Title -->
            <TextBlock Text="GRAVA&#xc7;&#xc3;O DE V&#xcd;DEO" FontSize="18" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,4,0,2"/>
            <TextBlock Text="Configure a grava&#xe7;&#xe3;o dos seus jogos" FontSize="11" Foreground="#778899"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Enable toggle -->
            <Border Background="#161622" CornerRadius="12" Padding="16,12" HorizontalAlignment="Center"
                    MinWidth="400" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Grava&#xe7;&#xe3;o ativada" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Pressione F9 durante o jogo para gravar" FontSize="10" Foreground="#667788" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="EnableToggle" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  Checked="EnableToggle_Changed" Unchecked="EnableToggle_Changed"/>
                </Grid>
            </Border>

            <!-- Recording Mode -->
            <Border Background="#161622" CornerRadius="12" Padding="16,12" HorizontalAlignment="Center"
                    MinWidth="400" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Modo de grava&#xe7;&#xe3;o" FontSize="13" FontWeight="SemiBold" Foreground="White"
                               Margin="0,0,0,10"/>

                    <RadioButton x:Name="ModeScreen" GroupName="RecMode" Foreground="White" FontSize="12"
                                 Margin="0,0,0,8" Checked="Mode_Changed">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Monitor" Width="16" Height="16" Foreground="#778899"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Apenas captura de tela" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ModeMic" GroupName="RecMode" Foreground="White" FontSize="12"
                                 Margin="0,0,0,8" Checked="Mode_Changed">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Microphone" Width="16" Height="16" Foreground="#4FC3F7"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Somente Microfone" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="  (tela + &#xe1;udio)" Foreground="#556677" VerticalAlignment="Center" FontSize="10"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ModeFacecam" GroupName="RecMode" Foreground="White" FontSize="12"
                                 Checked="Mode_Changed">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Webcam" Width="16" Height="16" Foreground="#FF1744"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Facecam + Microfone" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="  (tela + cam + &#xe1;udio)" Foreground="#556677" VerticalAlignment="Center" FontSize="10"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Facecam Position -->
            <Border x:Name="FacecamSection" Background="#161622" CornerRadius="12" Padding="16,12"
                    HorizontalAlignment="Center" MinWidth="400" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Posi&#xe7;&#xe3;o da facecam" FontSize="13" FontWeight="SemiBold" Foreground="White"
                               Margin="0,0,0,10"/>
                    <UniformGrid Rows="2" Columns="2" HorizontalAlignment="Center" Width="280">
                        <Border x:Name="PosTopLeft" Background="#0A0E1A" CornerRadius="8" Padding="6" Margin="4"
                                Cursor="Hand" MouseLeftButtonUp="FacecamPos_Click" Tag="top_left"
                                BorderThickness="2" BorderBrush="Transparent">
                            <Grid Width="100" Height="56">
                                <Border Background="#111528" CornerRadius="4"/>
                                <Border Width="22" Height="16" Background="#FF1744" CornerRadius="3"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,5,0,0" Opacity="0.9"/>
                                <TextBlock Text="Superior Esq." FontSize="8" Foreground="#556677"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </Grid>
                        </Border>
                        <Border x:Name="PosTopRight" Background="#0A0E1A" CornerRadius="8" Padding="6" Margin="4"
                                Cursor="Hand" MouseLeftButtonUp="FacecamPos_Click" Tag="top_right"
                                BorderThickness="2" BorderBrush="Transparent">
                            <Grid Width="100" Height="56">
                                <Border Background="#111528" CornerRadius="4"/>
                                <Border Width="22" Height="16" Background="#FF1744" CornerRadius="3"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,6,0" Opacity="0.9"/>
                                <TextBlock Text="Superior Dir." FontSize="8" Foreground="#556677"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </Grid>
                        </Border>
                        <Border x:Name="PosBottomLeft" Background="#0A0E1A" CornerRadius="8" Padding="6" Margin="4"
                                Cursor="Hand" MouseLeftButtonUp="FacecamPos_Click" Tag="bottom_left"
                                BorderThickness="2" BorderBrush="Transparent">
                            <Grid Width="100" Height="56">
                                <Border Background="#111528" CornerRadius="4"/>
                                <Border Width="22" Height="16" Background="#FF1744" CornerRadius="3"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,5" Opacity="0.9"/>
                                <TextBlock Text="Inferior Esq." FontSize="8" Foreground="#556677"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </Grid>
                        </Border>
                        <Border x:Name="PosBottomRight" Background="#0A0E1A" CornerRadius="8" Padding="6" Margin="4"
                                Cursor="Hand" MouseLeftButtonUp="FacecamPos_Click" Tag="bottom_right"
                                BorderThickness="2" BorderBrush="Transparent">
                            <Grid Width="100" Height="56">
                                <Border Background="#111528" CornerRadius="4"/>
                                <Border Width="22" Height="16" Background="#FF1744" CornerRadius="3"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,5" Opacity="0.9"/>
                                <TextBlock Text="Inferior Dir." FontSize="8" Foreground="#556677"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </Grid>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Device selectors -->
            <Border x:Name="DeviceSection" Background="#161622" CornerRadius="12" Padding="16,12"
                    HorizontalAlignment="Center" MinWidth="400" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Dispositivos" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="RefreshDevicesBtn" Grid.Column="1" Click="RefreshDevices_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#4FC3F7" FontWeight="Bold" FontSize="10" Padding="8,2"
                                ToolTip="Recarregar lista de dispositivos">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="ATUALIZAR" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel x:Name="WebcamRow" Margin="0,0,0,10">
                        <TextBlock Text="Webcam" FontSize="11" Foreground="#778899" Margin="0,0,0,4"/>
                        <ComboBox x:Name="WebcamCombo" Foreground="White" FontSize="12"
                                  Background="#0A0E1A" MinWidth="360"
                                  SelectionChanged="WebcamCombo_Changed"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Microfone" FontSize="11" Foreground="#778899" Margin="0,0,0,4"/>
                        <ComboBox x:Name="MicCombo" Foreground="White" FontSize="12"
                                  Background="#0A0E1A" MinWidth="360"
                                  SelectionChanged="MicCombo_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Permission warning -->
            <Border x:Name="PermissionWarning" Background="#1A1400" CornerRadius="12" Padding="16,12"
                    HorizontalAlignment="Center" MinWidth="400" Margin="0,0,0,14" Visibility="Collapsed"
                    BorderBrush="#33FFD740" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <md:PackIcon Kind="ShieldAlert" Width="18" Height="18" Foreground="#FFD740"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Permiss&#xe3;o necess&#xe1;ria" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FFD740" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="PermissionMessage" TextWrapping="Wrap" FontSize="11" Foreground="#AABB88"
                               LineHeight="18" Margin="0,0,0,12">
                        Nenhum dispositivo encontrado. O Windows pode estar bloqueando o acesso
                        &#xe0; c&#xe2;mera e/ou microfone. Abra as configura&#xe7;&#xf5;es de privacidade e ative o acesso:
                    </TextBlock>
                    <WrapPanel HorizontalAlignment="Center">
                        <Button x:Name="OpenCameraSettingsBtn" Click="OpenCameraSettings_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#FF1744" FontWeight="Bold" FontSize="10" Padding="10,4" Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Webcam" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="C&#xc2;MERA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenMicSettingsBtn" Click="OpenMicSettings_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#4FC3F7" FontWeight="Bold" FontSize="10" Padding="10,4" Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Microphone" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="MICROFONE" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Hotkey display -->
            <Border Background="#161622" CornerRadius="12" Padding="16,12" HorizontalAlignment="Center"
                    MinWidth="400" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Tecla de atalho" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Pressione durante o jogo para iniciar/parar" FontSize="10" Foreground="#667788" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#22FF1744" CornerRadius="8" Padding="14,6"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="HotkeyText" Text="F9" FontSize="14" FontWeight="Bold"
                                   Foreground="#FF1744" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Resolution selector -->
            <Border Background="#161622" CornerRadius="12" Padding="16,12" HorizontalAlignment="Center"
                    MinWidth="400" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Resolu&#xe7;&#xe3;o de grava&#xe7;&#xe3;o" FontSize="13" FontWeight="SemiBold" Foreground="White"
                               Margin="0,0,0,10"/>

                    <RadioButton x:Name="Rb720" GroupName="Resolution" Foreground="White" FontSize="12"
                                 Margin="0,0,0,8" Checked="Resolution_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="720p" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="  (1280&#xd7;720) &#x2014; 60 FPS" Foreground="#778899" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="Rb1080" GroupName="Resolution" Foreground="White" FontSize="12"
                                 Margin="0,0,0,8" Checked="Resolution_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="1080p" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="  (1920&#xd7;1080) &#x2014; 60 FPS" Foreground="#778899" VerticalAlignment="Center"/>
                            <Border Background="#2200E676" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Recomendado" FontSize="9" Foreground="#00E676" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="Rb4K" GroupName="Resolution" Foreground="White" FontSize="12"
                                 Checked="Resolution_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="4K" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="  (3840&#xd7;2160) &#x2014; 60 FPS" Foreground="#778899" VerticalAlignment="Center"/>
                            <Border Background="#22FFD740" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Pesado" FontSize="9" Foreground="#FFD740" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Output folder -->
            <Border Background="#161622" CornerRadius="12" Padding="16,10" HorizontalAlignment="Center"
                    MinWidth="400" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Pasta de sa&#xed;da" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="OutputPathText" Text="" FontSize="9" Foreground="#556677" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="ABRIR" Click="OpenFolder_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#4FC3F7" FontWeight="Bold" FontSize="11" Padding="10,4"/>
                </Grid>
            </Border>

            <!-- FFmpeg status -->
            <Border x:Name="FfmpegStatusBorder" Background="#161622" CornerRadius="12" Padding="16,10"
                    HorizontalAlignment="Center" MinWidth="400">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <md:PackIcon x:Name="FfmpegIcon" Kind="CheckCircle" Width="18" Height="18"
                                 Foreground="#00E676" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="FfmpegStatusText" Text="FFmpeg pronto" FontSize="12"
                               Foreground="#00E676" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
