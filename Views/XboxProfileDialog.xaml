<Window x:Class="GameLauncher.Views.XboxProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:GameLauncher.Converters"
        Title="&#x1f3ae; Perfil Xbox Live"
        Width="460" Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0D0D0D"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}">
    <Window.Resources>
        <converters:UrlToImageSourceConverter x:Key="UrlToImage"/>
    </Window.Resources>
    <Grid>
        <Border VerticalAlignment="Top" Height="110">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#107C10" Offset="0"/>
                    <GradientStop Color="#0D0D0D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <StackPanel HorizontalAlignment="Center" Margin="0,30,0,0">
            <Grid Width="96" Height="96" HorizontalAlignment="Center">
                <Ellipse Width="96" Height="96" Fill="#1A2533" Stroke="#107C10" StrokeThickness="3">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#107C10" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                    </Ellipse.Effect>
                </Ellipse>
                <md:PackIcon Kind="MicrosoftXbox" Width="48" Height="48" Foreground="#334455" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="FallbackIcon"/>
                <Ellipse x:Name="AvatarEllipse" Width="90" Height="90" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="GamertagText" Text="&#x2014;" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,14,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.7"/>
                </TextBlock.Effect>
            </TextBlock>
            <Border x:Name="TierBadge" CornerRadius="12" Padding="14,4" HorizontalAlignment="Center" Margin="0,6,0,0" Background="#22107C10">
                <TextBlock x:Name="TierText" Text="Xbox Live" FontSize="11" FontWeight="SemiBold" Foreground="#107C10"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Border Background="#161622" CornerRadius="12" Padding="14,12" MinWidth="120">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <md:PackIcon Kind="Trophy" Width="18" Height="18" Foreground="#FFD700" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="GAMERSCORE" FontSize="9" FontWeight="SemiBold" Foreground="#778899" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="GamerscoreText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#FFD700" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#161622" CornerRadius="12" Padding="14,12" MinWidth="110" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <md:PackIcon Kind="CheckCircle" Width="18" Height="18" Foreground="#107C10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="IMPORTADOS" FontSize="9" FontWeight="SemiBold" Foreground="#778899" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="ImportedCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#107C10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#161622" CornerRadius="12" Padding="14,12" MinWidth="110" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <md:PackIcon Kind="Download" Width="18" Height="18" Foreground="#4FC3F7" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="DISPON&#xCD;VEIS" FontSize="9" FontWeight="SemiBold" Foreground="#778899" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="AvailableCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#4FC3F7" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock x:Name="XuidText" Text="" FontSize="10" Foreground="#556677" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Content="IMPORTAR JOGOS XBOX" Click="ImportGames_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#107C10" FontWeight="Bold" Margin="0,0,8,0"/>
                <Button Content="SAIR DA CONTA" Click="Logout_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#FF5252" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>