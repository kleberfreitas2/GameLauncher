<Window x:Class="GameLauncher.Views.EpicProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="&#x1f3ae; Perfil Epic Games"
        Width="460" Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0D0D0D"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid>
        <Border VerticalAlignment="Top" Height="110">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1A1A1A" Offset="0"/>
                    <GradientStop Color="#0D0D0D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel HorizontalAlignment="Center" Margin="0,30,0,0">
            <Grid Width="96" Height="96" HorizontalAlignment="Center">
                <Ellipse Width="96" Height="96" Fill="#000000" Stroke="#333333" StrokeThickness="3">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Image Source="/Assets/epic_logo.png" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>

            <TextBlock x:Name="DisplayNameText" Text="&#x2014;" FontSize="22" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,14,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.7"/>
                </TextBlock.Effect>
            </TextBlock>

            <Border CornerRadius="12" Padding="14,4"
                    HorizontalAlignment="Center" Margin="0,6,0,0" Background="#2200B4D8">
                <TextBlock Text="Epic Games" FontSize="11"
                           FontWeight="SemiBold" Foreground="#00B4D8"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Border Background="#161622" CornerRadius="12" Padding="14,12" MinWidth="120">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <md:PackIcon Kind="GamepadVariant" Width="18" Height="18"
                                         Foreground="#00B4D8" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="JOGOS INSTALADOS" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#778899" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TotalGamesText" Text="0" FontSize="22" FontWeight="Bold"
                                   Foreground="#00B4D8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#161622" CornerRadius="12" Padding="14,12" MinWidth="110" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <md:PackIcon Kind="CheckCircle" Width="18" Height="18"
                                         Foreground="#00B4D8" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="IMPORTADOS" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#778899" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="ImportedCountText" Text="0" FontSize="22" FontWeight="Bold"
                                   Foreground="#00B4D8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#161622" CornerRadius="12" Padding="14,12" MinWidth="110" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <md:PackIcon Kind="Download" Width="18" Height="18"
                                         Foreground="#4FC3F7" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="DISPON&#xCD;VEIS" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#778899" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="AvailableCountText" Text="0" FontSize="22" FontWeight="Bold"
                                   Foreground="#4FC3F7" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Button Content="IMPORTAR JOGOS EPIC" Click="ImportGames_Click"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#00B4D8" FontWeight="Bold" Margin="0,0,8,0"/>
                <Button Content="DESCONECTAR" Click="Logout_Click"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#FF5252" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
