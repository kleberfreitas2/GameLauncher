<Window x:Class="GameLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:ctrl="clr-namespace:GameLauncher.Controls" xmlns:converters="clr-namespace:GameLauncher.Converters" Title="GLauncher" Icon="Assets/icon.ico" Height="700" Width="1200" MinHeight="500" MinWidth="800" WindowStartupLocation="CenterScreen" TextElement.Foreground="{DynamicResource MaterialDesignBody}" TextElement.FontFamily="{DynamicResource MaterialDesignFont}" Background="{DynamicResource AppBackgroundBrush}">
  <Window.Resources>
    <Style x:Key="HeaderActionButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="20,10"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.35"/></Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.87"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Logo -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/icon.png" Width="44" Height="44" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="20" FontWeight="Bold">
              <Run Text="G" Foreground="{DynamicResource AccentGreenBrush}"/><Run Text="Launcher" Foreground="White"/>
            </TextBlock>
            <TextBlock Text="Seus jogos favoritos em um so lugar" FontSize="11" Foreground="#9999BB"/>
          </StackPanel>
        </StackPanel>

        <!-- Search bar -->
        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12,8" Margin="30,0" VerticalAlignment="Center" MaxWidth="600">
          <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="3" Opacity="0.5"/></Border.Effect>
          <DockPanel>
            <md:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="#0088FF" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,10,0">
              <md:PackIcon.Effect><DropShadowEffect Color="#00AAFF" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/></md:PackIcon.Effect>
            </md:PackIcon>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent" BorderThickness="0" Foreground="#0077EE" FontSize="14" FontWeight="Medium"
                     VerticalAlignment="Center" CaretBrush="#0088FF"
                     md:HintAssist.Hint="Buscar jogo..."
                     md:HintAssist.Foreground="#AABBDD"
                     md:TextFieldAssist.DecorationVisibility="Hidden"/>
          </DockPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Fundo" Command="{Binding ChangeBackgroundCommand}" Style="{StaticResource HeaderActionButton}" Margin="0,0,10,0"/>
          <Button Content="Tema" Command="{Binding OpenThemeCommand}" Style="{StaticResource HeaderActionButton}" Margin="0,0,10,0"/>
          <Button Content="+ ADICIONAR JOGO" Command="{Binding AddGameCommand}" Style="{StaticResource HeaderActionButton}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="250"/>
      </Grid.RowDefinitions>

      <!-- WALLPAPER GLOBAL -->
      <Image Grid.RowSpan="2" Source="{Binding BackgroundImage}" Stretch="UniformToFill" Opacity="0.30" Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>

      <!-- ═══ HERO ═══ -->
      <Grid Grid.Row="0" ClipToBounds="True">
        <!-- Capa desfocada do jogo selecionado -->
        <Image Source="{Binding SelectedGame.EffectiveImagePath, Converter={StaticResource PathToImageConverter}}" Stretch="UniformToFill" Opacity="0.40" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"><Image.Effect><BlurEffect Radius="22" KernelType="Gaussian"/></Image.Effect></Image>
        <!-- Gradiente escurecedor -->
        <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#77000000" Offset="0.0"/><GradientStop Color="#F0020212" Offset="1.0"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
        <!-- Estado vazio -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Games.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
          <md:PackIcon Kind="GamepadVariantOutline" Width="90" Height="90" Foreground="#2A2A2A" HorizontalAlignment="Center"/>
          <TextBlock Text="Nenhum jogo adicionado ainda" FontSize="20" Foreground="#555555" HorizontalAlignment="Center" Margin="0,16,0,0"/>
          <TextBlock Text="Clique em + ADICIONAR JOGO para começar" FontSize="13" Foreground="#444444" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
        <!-- Conteúdo hero (quando há jogo selecionado) -->
        <Grid VerticalAlignment="Bottom" Margin="36,0,36,24"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasGames}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="148"/></Grid.ColumnDefinitions>
          <!-- Painel de informações (glass) -->
          <Border Grid.Column="0" Background="#88050514" CornerRadius="14" Padding="28,22" BorderBrush="#22FFFFFF" BorderThickness="1" Margin="0,0,16,0"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <!-- Badge favorito -->
              <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGame.IsFavorite}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <md:PackIcon Kind="Star" Width="13" Height="13" Foreground="#FFD700" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="FAVORITO" FontSize="10" Foreground="#FFD700" FontWeight="Bold" VerticalAlignment="Center"/>
              </StackPanel>
              <!-- Título -->
              <TextBlock Grid.Row="1" Text="{Binding SelectedGame.DisplayName}" FontSize="36" FontWeight="Bold" Foreground="White" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <!-- Linha de ações -->
              <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Center">
                <md:PackIcon Kind="ClockOutline" Width="13" Height="13" Foreground="#9999BB" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding SelectedGame.LastPlayedText}" Foreground="#9999BB" FontSize="12" VerticalAlignment="Center" Margin="0,0,22,0"/>
                <!-- Botão JOGAR -->
                <Button Command="{Binding LaunchGameCommand}" CommandParameter="{Binding SelectedGame}" Padding="24,10" BorderThickness="0" Cursor="Hand">
                  <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><Border.Effect><DropShadowEffect Color="#7C4DFF" BlurRadius="18" ShadowDepth="0" Opacity="0.65"/></Border.Effect><StackPanel Orientation="Horizontal"><md:PackIcon Kind="Play" Width="15" Height="15" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="JOGAR" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Button.Style>
                </Button>
                <!-- Favoritar -->
                <Button Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding SelectedGame}" Padding="10,10" BorderThickness="0" Cursor="Hand" ToolTip="Favoritar" Margin="8,0,0,0">
                  <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="#33FFFFFF"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><md:PackIcon Kind="{Binding SelectedGame.FavoriteIcon}" Width="15" Height="15" Foreground="{Binding SelectedGame.FavoriteColor}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Button.Style>
                </Button>
                <!-- Renomear -->
                <Button Command="{Binding RenameGameCommand}" CommandParameter="{Binding SelectedGame}" Padding="10,10" BorderThickness="0" Cursor="Hand" ToolTip="Renomear" Margin="4,0,0,0">
                  <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="#33FFFFFF"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><md:PackIcon Kind="Pencil" Width="15" Height="15" Foreground="#AAAAFF" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Button.Style>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
          <!-- Thumbnail da capa -->
          <Border Grid.Column="1" Height="160" VerticalAlignment="Bottom" CornerRadius="12" ClipToBounds="True" Background="#44000010" BorderBrush="#33FFFFFF" BorderThickness="1">
            <Grid><md:PackIcon Kind="GamepadVariant" Width="48" Height="48" Foreground="#3A3A5A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SelectedGame.HasNoImage, Converter={StaticResource BoolToVisibility}}"/><Image Source="{Binding SelectedGame.EffectiveImagePath, Converter={StaticResource PathToImageConverter}}" Stretch="UniformToFill" Visibility="{Binding SelectedGame.HasImage, Converter={StaticResource BoolToVisibility}}"/></Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- ═══ FAIXA DE CARDS ═══ -->
      <Border Grid.Row="1" Background="#CC030310" BorderBrush="#18FFFFFF" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <!-- Label + status -->
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="22,0,0,0">
            <TextBlock Text="BIBLIOTECA" FontSize="9" FontWeight="Bold" Foreground="#444466"/>
            <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="#666688" Margin="0,3,0,0"/>
          </StackPanel>
          <!-- Cards horizontais -->
          <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Padding="14,14">
            <ItemsControl ItemsSource="{Binding GamesView}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border x:Name="SelectionBorder" Width="135" Height="190" Margin="5,3" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" Padding="0">
                  <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource EqualityConverter}"><Binding/><Binding Path="DataContext.SelectedGame" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/></MultiBinding></DataTrigger.Binding><Setter Property="BorderBrush" Value="#00E676"/><Setter Property="BorderThickness" Value="3"/></DataTrigger></Style.Triggers></Style></Border.Style>
                  <Border x:Name="CardRoot" CornerRadius="9" Cursor="Hand" ClipToBounds="True" Background="#AA0A0A20" BorderBrush="#22FFFFFF" BorderThickness="1">
                    <Border.InputBindings>
                      <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                      <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                    </Border.InputBindings>
                    <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="#BB1A1A38"/></Setter.Value></Setter><Setter Property="Tag" Value="1"/></Trigger><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FFD700" BlurRadius="14" ShadowDepth="0" Opacity="0.5"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Border.Style>
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
                      <!-- Capa -->
                      <Border Grid.Row="0" ClipToBounds="True"><Grid><md:PackIcon Kind="GamepadVariant" Width="48" Height="48" Foreground="#5A4DFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoImage, Converter={StaticResource BoolToVisibility}}"/><Image Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}" Source="{Binding EffectiveImagePath, Converter={StaticResource PathToImageConverter}, ConverterParameter=135}" Stretch="UniformToFill"/></Grid></Border>
                      <!-- Botões de ação (hover) -->
                      <Border Grid.Row="0" VerticalAlignment="Top" Panel.ZIndex="1" Background="#BB111130"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,3,3,3"><Button Width="24" Height="24" Padding="0" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Background="#22223A" BorderThickness="0" ToolTip="Favorito" Margin="0,0,2,0"><md:PackIcon Kind="{Binding FavoriteIcon}" Width="12" Height="12" Foreground="{Binding FavoriteColor}"/></Button><Button Width="24" Height="24" Padding="0" Command="{Binding DataContext.ChangeImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Background="#333355" BorderThickness="0" ToolTip="Alterar imagem" Margin="0,0,2,0"><md:PackIcon Kind="Camera" Width="12" Height="12" Foreground="#AAAAFF"/></Button><Button Width="24" Height="24" Padding="0" Command="{Binding DataContext.SearchCoverCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Background="#223344" BorderThickness="0" ToolTip="Buscar capa" Margin="0,0,2,0"><md:PackIcon Kind="Magnify" Width="12" Height="12" Foreground="#66AAFF"/></Button><Button Width="24" Height="24" Padding="0" Command="{Binding DataContext.RenameGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Background="#223322" BorderThickness="0" ToolTip="Renomear" Margin="0,0,2,0"><md:PackIcon Kind="Pencil" Width="12" Height="12" Foreground="#88FF88"/></Button><Button Width="24" Height="24" Padding="0" Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Background="#AA2222" BorderThickness="0" ToolTip="Remover"><md:PackIcon Kind="Close" Width="12" Height="12" Foreground="White"/></Button></StackPanel></Border>
                      <!-- Badge A do controle -->
                      <Border Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="5" Background="#D9000000"><Border.Visibility><MultiBinding Converter="{StaticResource SelectedGamepadVisibilityConverter}"><Binding/><Binding Path="DataContext.SelectedGame" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/><Binding Path="DataContext.GamepadConnected" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/></MultiBinding></Border.Visibility><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="24" Height="24" CornerRadius="12" Background="#00C853" Margin="0,0,6,0"><TextBlock Text="A" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="JOGAR" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/></StackPanel></Border>
                      <!-- Barra inferior glass -->
                      <Border Grid.Row="1" Background="#BB000010"><StackPanel Margin="9,7" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontSize="10" FontWeight="SemiBold" Foreground="White" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LastPlayedText}" FontSize="8" Foreground="#8888AA" Margin="0,2,0,0"/></StackPanel></Border>
                    </Grid>
                  </Border>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
    <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}" Padding="20,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Status text -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock Text="{Binding StatusMessage}" Foreground="#888888" FontSize="12"/>
          <TextBlock Text="Desenvolvido por Kleber Freitas" Foreground="#666688" FontSize="10" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Gamepad status (centro) -->
        <TextBlock Grid.Column="1" Text="{Binding GamepadStatus}" Foreground="#00E676" FontSize="11"
                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Hardware Gauges -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
          <!-- CPU Usage -->
          <ctrl:ArcGauge Value="{Binding CpuUsage}" Label="CPU" SubLabel="{Binding CpuTempText}" Margin="4,0"/>
          <!-- GPU Usage -->
          <ctrl:ArcGauge Value="{Binding GpuUsage}" Label="GPU" SubLabel="{Binding GpuTempText}" Margin="4,0"/>
          <!-- CPU Temp -->
          <ctrl:ArcGauge Value="{Binding CpuTemp}" Label="CPU °C" IsTemperature="True" Margin="4,0"/>
          <!-- GPU Temp -->
          <ctrl:ArcGauge Value="{Binding GpuTemp}" Label="GPU °C" IsTemperature="True" Margin="4,0"/>
          <!-- RAM -->
          <ctrl:ArcGauge Value="{Binding RamUsage}" Label="RAM" Margin="4,0"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
